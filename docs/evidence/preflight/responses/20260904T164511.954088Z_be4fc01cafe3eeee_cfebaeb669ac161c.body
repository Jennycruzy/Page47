CK BETTING LICENSE APPLICATIONS","EventItemTally":null,"EventItemAccelaRecordId":null,"EventItemConsent":0,"EventItemMoverId":null,"EventItemMover":null,"EventItemSeconderId":null,"EventItemSeconder":null,"EventItemMatterId":null,"EventItemMatterGuid":null,"EventItemMatterFile":null,"EventItemMatterName":null,"EventItemMatterType":null,"EventItemMatterStatus":null,"EventItemMatterAttachments":[]},{"EventItemId":64811,"EventItemGuid":"95268271-FBAF-4817-874F-0E0DB7362D1B","EventItemLastModifiedUtc":"2026-07-15T19:30:46.963","EventItemRowVersion":"AAAAAASVFl8=","EventItemEventId":2651,"EventItemAgendaSequence":43,"EventItemMinutesSequence":47,"EventItemAgendaNumber":null,"EventItemVideo":null,"EventItemVideoIndex":null,"EventItemVersion":null,"EventItemAgendaNote":"Ordinance S-53065 is a request to authorize the City Controller to disburse funds, up to amounts indicated below, for the purpose of paying vendors, contractors, claimants and others, and providing additional payment authority under certain existing city contracts. This section also requests continuing payment authority, up to amounts indicated below, for the following contracts, contract extensions and/or bids awarded. As indicated below, some items below require payment pursuant to Phoenix City Code Section 42-13.","EventItemMinutesNote":null,"EventItemActionId":null,"EventItemActionName":null,"EventItemActionText":null,"EventItemPassedFlag":null,"EventItemPassedFlagName":null,"EventItemRollCallFlag":0,"EventItemFlagExtra":0,"EventItemTitle":"ORDINANCES, RESOLUTIONS, AND NEW BUSINESS","EventItemTally":null,"EventItemAccelaRecordId":null,"EventItemConsent":0,"EventItemMoverId":null,"EventItemMover":null,"EventItemSeconderId":null,"EventItemSeconder":null,"EventItemMatterId":null,"EventItemMatterGuid":null,"EventItemMatterFile":null,"EventItemMatterName":null,"EventItemMatterType":null,"EventItemMatterStatus":null,"EventItemMatterAttachments":[]},{"EventItemId":64824,"EventItemGuid":"8BA1FF86-167E-4C29-BA4E-72D291CC67A2","EventItemLastModifiedUtc":"2026-07-02T15:29:28.183","EventItemRowVersion":"AAAAAASVFl8=","EventItemEventId":2651,"EventItemAgendaSequence":58,"EventItemMinutesSequence":null,"EventItemAgendaNumber":null,"EventItemVideo":null,"EventItemVideoIndex":null,"EventItemVersion":null,"EventItemAgendaNote":null,"EventItemMinutesNote":null,"EventItemActionId":null,"EventItemActionName":null,"EventItemActionText":null,"EventItemPassedFlag":null,"EventItemPassedFlagName":null,"EventItemRollCallFlag":0,"EventItemFlagExtra":0,"EventItemTitle":"ADMINISTRATION","EventItemTally":null,"EventItemAccelaRecordId":null,"EventItemConsent":0,"EventItemMoverId":null,"EventItemMover":null,"EventItemSeconderId":null,"EventItemSeconder":null,"EventItemMatterId":null,"EventItemMatterGuid":null,"EventItemMatterFile":null,"EventItemMatterName":null,"EventItemMatterType":null,"EventItemMatterStatus":null,"EventItemMatterAttachments":[]},{"EventItemId":64829,"EventItemGuid":"71C51E49-85C3-41CE-806E-334663C54447","EventItemLastModifiedUtc":"2026-07-02T15:29:28.183","EventItemRowVersion":"AAAAAASVFl8=","EventItemEventId":2651,"EventItemAgendaSequence":64,"EventItemMinutesSequence":null,"EventItemAgendaNumber":null,"EventItemVideo":null,"EventItemVideoIndex":null,"EventItemVersion":null,"EventItemAgendaNote":null,"EventItemMinutesNote":null,"EventItemActionId":null,"EventItemActionName":null,"EventItemActionText":null,"EventItemPassedFlag":null,"EventItemPassedFlagName":null,"EventItemRollCallFlag":0,"EventItemFlagExtra":0,"EventItemTitle":"COMMUNITY SERVICES","EventItemTally":null,"EventItemAccelaRecordId":null,"EventItemConsent":0,"EventItemMoverId":null,"EventItemMover":null,"EventItemSeconderId":null,"EventItemSeconder":null,"EventItemMatterId":null,"EventItemMatterGuid":null,"EventItemMatterFile":null,"EventItemMatterName":null,"EventItemMatterType":null,"EventItemMatterStatus":null,"EventItemMatterAttachments":[]},{"EventItemId":64838,"EventItemGuid":"F2D1B815-5B78-4B57-B8FB-FF9340302AB1","EventItemLastModifiedUtc":"2026-07-02T15:29:28.18","EventItemRowVersion":"AAAAAASVFl8=","EventItemEventId":2651,"EventItemAgendaSequence":72,"EventItemMinutesSequence":null,"EventItemAgendaNumber":null,"EventItemVideo":null,"EventItemVideoIndex":null,"EventItemVersion":null,"EventItemAgendaNote":null,"EventItemMinutesNote":null,"EventItemActionId":null,"EventItemActionName":null,"EventItemActionText":null,"EventItemPassedFlag":null,"EventItemPassedFlagName":null,"EventItemRollCallFlag":0,"EventItemFlagExtra":0,"EventItemTitle":"PUBLIC SAFETY","EventItemTally":null,"EventItemAccelaRecordId":null,"EventItemConsent":0,"EventItemMoverId":null,"EventItemMover":null,"EventItemSeconderId":null,"EventItemSeconder":null,"EventItemMatterId":null,"EventItemMatterGuid":null,"EventItemMatterFile":null,"EventItemMatterName":null,"EventItemMatterType":null,"EventItemMatterStatus":null,"EventItemMatterAttachments":[]},{"EventItemId":64841,"EventItemGuid":"AC06D7CC-D265-4ED7-AA56-58FA4B98F600","EventItemLastModifiedUtc":"2026-07-02T15:29:28.18","EventItemRowVersion":"AAAAAASVFl8=","EventItemEventId":2651,"EventItemAgendaSequence":76,"EventItemMinutesSequence":null,"EventItemAgendaNumber":null,"EventItemVideo":null,"EventItemVideoIndex":null,"EventItemVersion":null,"EventItemAgendaNote":null,"EventItemMinutesNote":null,"EventItemActionId":null,"EventItemActionName":null,"EventItemActionText":null,"EventItemPassedFlag":null,"EventItemPassedFlagName":null,"EventItemRollCallFlag":0,"EventItemFlagExtra":0,"EventItemTitle":"TRANSPORTATION AND INFRASTRUCTURE","EventItemTally":null,"EventItemAccelaRecordId":null,"EventItemConsent":0,"EventItemMoverId":null,"EventItemMover":null,"EventItemSeconderId":null,"EventItemSeconder":null,"EventItemMatterId":null,"EventItemMatterGuid":null,"EventItemMatterFile":null,"EventItemMatterName":null,"EventItemMatterType":null,"EventItemMatterStatus":null,"EventItemMatterAttachments":[]},{"EventItemId":64854,"EventItemGuid":"0BBEE8C2-E7CC-425B-88D2-31F1A0D9C5FE","EventItemLastModifiedUtc":"2026-07-02T15:29:28.177","EventItemRowVersion":"AAAAAASVFl8=","EventItemEventId":2651,"EventItemAgendaSequence":87,"EventItemMinutesSequence":null,"EventItemAgendaNumber":null,"EventItemVideo":null,"EventItemVideoIndex":null,"EventItemVersion":null,"EventItemAgendaNote":null,"EventItemMinutesNote":null,"EventItemActionId":null,"EventItemActionName":null,"EventItemActionText":null,"EventItemPassedFlag":null,"EventItemPassedFlagName":null,"EventItemRollCallFlag":0,"EventItemFlagExtra":0,"EventItemTitle":"PLANNING AND ZONING MATTERS","EventItemTally":null,"EventItemAccelaRecordId":null,"EventItemConsent":0,"EventItemMoverId":null,"EventItemMover":null,"EventItemSeconderId":null,"EventItemSeconder":null,"EventItemMatterId":null,"EventItemMatterGuid":null,"EventItemMatterFile":null,"EventItemMatterName":null,"EventItemMatterType":null,"EventItemMatterStatus":null,"EventItemMatterAttachments":[]},{"EventItemId":64862,"EventItemGuid":"B78BDE23-127B-4910-B915-33A8E0938316","EventItemLastModifiedUtc":"2026-07-02T15:29:28.173","EventItemRowVersion":"AAAAAASVFl8=","EventItemEventId":2651,"EventItemAgendaSequence":103,"EventItemMinutesSequence":null,"EventItemAgendaNumber":null,"EventItemVideo":null,"EventItemVideoIndex":null,"EventItemVersion":null,"EventItemAgendaNote":null,"EventItemMinutesNote":null,"EventItemActionId":null,"EventItemActionName":null,"EventItemActionText":null,"EventItemPassedFlag":null,"EventItemPassedFlagName":null,"EventItemRollCallFlag":0,"EventItemFlagExtra":0,"EventItemTitle":"REPORTS FROM CITY MANAGER, COMMITTEES OR CITY OFFICIALS","EventItemTally":null,"EventItemAccelaRecordId":null,"EventItemConsent":0,"EventItemMoverId":null,"EventItemMover":null,"EventItemSeconderId":null,"EventItemSeconder":null,"EventItemMatterId":null,"EventItemMatterGuid":null,"EventItemMatterFile":null,"EventItemMatterName":null,"EventItemMatterType":null,"EventItemMatterStatus":null,"EventItemMatterAttachments":[]},{"EventItemId":64863,"EventItemGuid":"2C8B7DCE-D09D-4C39-8A3D-032CAF2675FB","EventItemLastModifiedUtc":"2026-08-04T17:04:25.507","EventItemRowVersion":"AAAAAASVFl8=","EventItemEventId":2651,"EventItemAgendaSequence":105,"EventItemMinutesSequence":106,"EventItemAgendaNumber":null,"EventItemVideo":null,"EventItemVideoIndex":null,"EventItemVersion":null,"EventItemAgendaNote":null,"EventItemMinutesNote":"{\\rtf1\\ansi\\ansicpg1252\\deff0\\deflang1033{\\fonttbl{\\f0\\fnil\\fcharset0 Arial;}}\r\n{\\colortbl ;\\red0\\green0\\blue0;}\r\n\\viewkind4\\uc1\\pard\\cf1\\fs28 NOTE: Councilwoman O'Brien temporarily left the voting body.\\par\r\n\\par\r\nCity Attorney Julie Kriegh stated during Citizen Comment, members of the public may address the City Council for up to three minutes on issues of interest or concern to them. She advised the Arizona Open Meeting Law permits the City Council to listen to the comment, but prohibits council members from discussing or acting on the matters presented.\\par\r\n\\par\r\nAlex Johnson expressed his concern that Ahwatukee residents felt under-represented in District 6 and suggested splitting the district to better reflect its geography and demographics. He expressed frustration that the district had not publicly addressed community opposition to the proposed data center. He urged the Council to acknowledge potential health impacts of industrial development near homes and to respond to residents\\rquote  emails and concerns.\\par\r\n\\par\r\nNOTE: Councilwoman O'Brien returned to the voting body during Mr. Johnson's comments.\\par\r\n\\par\r\nDavid Morgan expressed his appreciation for the changes made to the SOS shelter in response to his previous stated concerns, highlighting that many of them had been addressed. He expressed his concerns for how disciplinary action was conducted at the facility, stating there was no oversight or formal process.\\par\r\n\\par\r\nNOTE: Mayor Gallego temporarily left the voting body during Mr. Morgan's comments. Vice Mayor Hodge Washington assumed the Chair\\par\r\n\\par\r\nClarissa Peterson expressed her appreciation for the sanitation efforts being made on the SOS lot. She expressed concern for how disciplinary action was conducted at the facility and behaviors from staff members.\\par\r\n\\par\r\nNOTE: Mayor Gallego returned to the voting body during Ms. Peterson's comments and assumed the Chair.\\par\r\n\\par\r\nFrank Urban expressed his concern for a bill he believed passed by Council that an ordinance limited aid to the homeless population to two times a month per park site.\\par\r\n\\par\r\nKarla Kendall expressed her concern for limited access to their mail while being a resident of the SOS facility and emphasized her well-being was dependent on receiving important letters. She expressed frustration with outages of electricity at the facility and noted the negative effects as a result.\\par\r\n\\par\r\nFaith Kearns expressed her concern for the environment of homeless shelters and urged the Council to provide more support\\par\r\n\\par\r\nWilliam Lockwood expressed his concern for an experience he had at the SOS shelter.\\par\r\n\\par\r\nJeremy Thacker expressed his support for the fair and intentional renaming of public parks and emphasized the need for names to be inspirational. He highlighted the importance of farmworker history and Jesse Owen.\\par\r\n\\par\r\nNOTE: Councilwoman Hernandez temporarily left the voting body.\\par\r\n\\par\r\nElsia Greer expressed her appreciation for the efforts made to improve the SOS facility. she expressed concern over the availability of adequate charging space for their wheelchair.\\par\r\n\\par\r\nElizabeth Venable expressed her concern for the availability of Americans with Disabilities Act compliant amenities at the SOS facility and the training of contractors present at the facility, including training material, culture, and relationship building with residents of the facility.\\par\r\n\\par\r\nNOTE: Councilwoman Hernandez returned to the voting body during Ms. Venable's comments.\\par\r\n\\par\r\nLee Ellis II noted the positive improvements made to the SOS facility but emphasized the need for more programs for its residents.\\par\r\n\\par\r\nDorian Vrenden emphasized the importance of heat relief during the summer months. He noted concern for the increase of ticketing and arrests of the homeless population and the effects of building of data centers.\\par\r\n\\par\r\nWilliam Kirkland expressed his concern for outages during hot summers. He expressed strong appreciation for the positive improvements to the SOS facility and noted the issues SOS residents face for receiving mail.\\par\r\n\\par\r\nDavid Benefiel expressed belief that God was responsible for the positive improvements seen recently in the City of Phoenix and read a scripture.\\par\r\n\\par\r\nMayor Gallego reminded speakers to comment on matters under the jurisdiction of the Council.\\par\r\n}\r\n","EventItemActionId":null,"EventItemActionName":null,"EventItemActionText":null,"EventItemPassedFlag":null,"EventItemPassedFlagName":null,"EventItemRollCallFlag":0,"EventItemFlagExtra":0,"EventItemTitle":"000 CITIZEN COMMENTS","EventItemTally":null,"EventItemAccelaRecordId":null,"EventItemConsent":0,"EventItemMoverId":null,"EventItemMover":null,"EventItemSeconderId":null,"EventItemSeconder":null,"EventItemMatterId":null,"EventItemMatterGuid":null,"EventItemMatterFile":null,"EventItemMatterName":null,"EventItemMatterType":null,"EventItemMatterStatus":null,"EventItemMatterAttachments":[]},{"EventItemId":64864,"EventItemGuid":"069A9348-85BE-4FBF-AA9F-62A7603E4F58","EventItemLastModifiedUtc":"2026-08-04T17:06:05.62","EventItemRowVersion":"AAAAAASVFl8=","EventItemEventId":2651,"EventItemAgendaSequence":106,"EventItemMinutesSequence":107,"EventItemAgendaNumber":null,"EventItemVideo":null,"EventItemVideoIndex":null,"EventItemVersion":null,"EventItemAgendaNote":null,"EventItemMinutesNote":"{\\rtf1\\ansi\\ansicpg1252\\deff0\\deflang1033{\\fonttbl{\\f0\\fnil\\fcharset0 Arial;}}\r\n{\\colortbl ;\\red0\\green0\\blue0;}\r\n\\viewkind4\\uc1\\pard\\fs28 There being no further business to come before the Council, Mayor Gallego declared the meeting adjourned at 12:30 p.m. \\par\r\n                                                                                                   \\par\r\n\\par\r\n___________________________\\par\r\nMAYOR\\par\r\n\\par\r\n\\par\r\nATTEST:\\par\r\n\\par\r\n\\par\r\n__________________________\\par\r\nCITY CLERK\\par\r\n\\par\r\n\\par\r\nSM (LM)\\par\r\n\\par\r\n\\ul\\par\r\n\\par\r\n\\par\r\n\\par\r\n\\par\r\n\\par\r\n\\par\r\n\\par\r\nCERTIFICATION\\par\r\n\\par\r\n\\ulnone I hereby certify that the foregoing minutes are a true and correct copy of the minutes of the formal session of the City Council of the City of Phoenix held on the 1st day of July, 2026. I further certify that the meeting was duly called and held and that a quorum was present.\\par\r\n\\par\r\nDated this 26th day of August, 2026.\\par\r\n\\par\r\n\\par\r\n__________________________\\par\r\nCITY CLERK\\cf1\\par\r\n}\r\n","EventItemActionId":null,"EventItemActionName":null,"EventItemActionText":null,"EventItemPassedFlag":null,"EventItemPassedFlagName":null,"EventItemRollCallFlag":0,"EventItemFlagExtra":0,"EventItemTitle":"ADJOURN","EventItemTally":null,"EventItemAccelaRecordId":null,"EventItemConsent":0,"EventItemMoverId":null,"EventItemMover":null,"EventItemSeconderId":null,"EventItemSeconder":null,"EventItemMatterId":null,"EventItemMatterGuid":null,"EventItemMatterFile":null,"EventItemMatterName":null,"EventItemMatterType":null,"EventItemMatterStatus":null,"EventItemMatterAttachments":[]},{"EventItemId":64865,"EventItemGuid":"9DBE6CCE-9600-4AF7-8AC5-5019215578EF","EventItemLastModifiedUtc":"2026-07-15T19:30:46.933","EventItemRowVersion":"AAAAAASVFl8=","EventItemEventId":2651,"EventItemAgendaSequence":7,"EventItemMinutesSequence":8,"EventItemAgendaNumber":null,"EventItemVideo":null,"EventItemVideoIndex":null,"EventItemVersion":null,"EventItemAgendaNote":null,"EventItemMinutesNote":null,"EventItemActionId":null,"EventItemActionName":null,"EventItemActionText":null,"EventItemPassedFlag":null,"EventItemPassedFlagName":null,"EventItemRollCallFlag":0,"EventItemFlagExtra":null,"EventItemTitle":"JUDGE APPOINTMENTS AND SWEARING-IN","EventItemTally":null,"EventItemAccelaRecordId":null,"EventItemConsent":0,"EventItemMoverId":null,"EventItemMover":null,"EventItemSeconderId":null,"EventItemSeconder":null,"EventItemMatterId":null,"EventItemMatterGuid":null,"EventItemMatterFile":null,"EventItemMatterName":null,"EventItemMatterType":null,"EventItemMatterStatus":null,"EventItemMatterAttachments":[]},{"EventItemId":64881,"EventItemGuid":"B4D55D78-7A89-45CC-8F3C-B8ACF7C68E0C","EventItemLastModifiedUtc":"2026-07-15T19:30:46.93","EventItemRowVersion":"AAAAAASVFl8=","EventItemEventId":2651,"EventItemAgendaSequence":3,"EventItemMinutesSequence":3,"EventItemAgendaNumber":null,"EventItemVideo":null,"EventItemVideoIndex":null,"EventItemVersion":null,"EventItemAgendaNote":null,"EventItemMinutesNote":null,"EventItemActionId":null,"EventItemActionName":null,"EventItemActionText":null,"EventItemPassedFlag":null,"EventItemPassedFlagName":null,"EventItemRollCallFlag":0,"EventItemFlagExtra":null,"EventItemTitle":"MINUTES OF MEETINGS","EventItemTally":null,"EventItemAccelaRecordId":null,"EventItemConsent":0,"EventItemMoverId":null,"EventItemMover":null,"EventItemSeconderId":null,"EventItemSeconder":null,"EventItemMatterId":null,"EventItemMatterGuid":null,"EventItemMatterFile":null,"EventItemMatterName":null,"EventItemMatterType":null,"EventItemMatterStatus":null,"EventItemMatterAttachments":[]},{"EventItemId":64883,"EventItemGuid":"946000D3-D601-4C08-ADD1-8A48ECABC2B6","EventItemLastModifiedUtc":"2026-09-02T20:48:11.513","EventItemRowVersion":"AAAAAASVFl8=","EventItemEventId":2651,"EventItemAgendaSequence":1,"EventItemMinutesSequence":null,"EventItemAgendaNumber":null,"EventItemVideo":null,"EventItemVideoIndex":null,"EventItemVersion":null,"EventItemAgendaNote":null,"EventItemMinutesNote":null,"EventItemActionId":null,"EventItemActionName":null,"EventItemActionText":null,"EventItemPassedFlag":null,"EventItemPassedFlagName":null,"EventItemRollCallFlag":0,"EventItemFlagExtra":null,"EventItemTitle":"If viewing this packet electronically in PDF, open and use bookmarks to navigate easily from one item to another.\r\n\r\nOPTIONS TO ACCESS THIS MEETING\r\n\r\nVirtual Request to speak at a meeting: \r\n\r\n- Register online by visiting the City Council Meetings page on phoenix.gov at least 2 hours prior to the start of this meeting. Then, click on this link at the time of the meeting and join the Webex to speak:\r\nhttps://phoenixcitycouncil.webex.com/phoenixcitycouncil/j.php?MTID=m3f6f34c704e343477ceae83d08b2d1b2\r\n\r\n- Register via telephone at 602-262-6001 at least 2 hours prior to the start of this meeting, noting the item number. Then, use the Call-in phone number and Meeting ID listed below at the time of the meeting to call-in and speak. \r\n\r\nIn-Person Requests to speak at a meeting:\r\n\r\n- Register in person at a kiosk located at the City Council Chambers, 200 W. Jefferson St., Phoenix, Arizona, 85003. Arrive 1 hour prior to the start of this meeting. Depending on seating availability, residents will attend and speak from the Upper Chambers, Lower Chambers or City Hall location.\r\n\r\n- Individuals should arrive early, 1 hour prior to the start of the meeting to submit an in-person request to speak before the item is called. After the item is called, requests to speak for that item will not be accepted.\r\n\r\nAt the time of the meeting:\r\n\r\n- Watch the meeting live streamed on phoenix.gov or Phoenix Channel 11 on Cox Cable, or using the Webex link provided above.\r\n\r\n- Call-in to listen to the meeting. Dial 602-666-0783 and Enter Meeting ID 2555 856 2898# (for English) or 2559 251 6084# (for Spanish). Press # again when prompted for attendee ID.\r\n\r\n- Watch the meeting in-person from the Upper Chambers, Lower Chambers or City Hall depending on seating availability.\r\n\r\n- Members of the public may attend this meeting in person. Physical access to the meeting location will be available starting 1 hour prior to the meeting.\r\n\r\nPara nuestros residentes de habla hispana:\t\r\n\r\n- Para registrarse para hablar en español, llame al 602-262-6001 al menos 2 horas antes del inicio de esta reunión e indique el número del tema. El día de la reunión, llame al 602-666-0783 e ingrese el número de identificación de la reunión 2559 251 6084#. El intérprete le indicará cuando sea su turno de hablar. \r\n\r\n- Para solamente escuchar la reunión en español, llame a este mismo número el día de la reunión (602-666-0783; ingrese el número de identificación de la reunión 2559 251 6084#). Se proporciona interpretación simultánea para nuestros residentes durante todas las reuniones.\r\n\r\n- Para asistir a la reunión en persona, vaya a las Cámaras del Concejo Municipal de Phoenix ubicadas en 200 W. Jefferson Street, Phoenix, AZ 85003. Llegue 1 hora antes del comienzo de la reunión. Si desea hablar, regístrese electrónicamente en uno de los quioscos, antes de que comience el tema. Una vez que se comience a discutir el tema, no se aceptarán nuevas solicitudes para hablar. Dependiendo de cuantos asientos haya disponibles, usted podría ser sentado en la parte superior de las cámaras, en el piso de abajo de las cámaras, o en el edificio municipal.\r\n\r\n- Miembros del público pueden asistir a esta reunión en persona. El acceso físico al lugar de la reunión estará disponible comenzando una hora antes de la reunión.","EventItemTally":null,"EventItemAccelaRecordId":null,"EventItemConsent":0,"EventItemMoverId":null,"EventItemMover":null,"EventItemSeconderId":null,"EventItemSeconder":null,"EventItemMatterId":null,"EventItemMatterGuid":null,"EventItemMatterFile":null,"EventItemMatterName":null,"EventItemMatterType":null,"EventItemMatterStatus":null,"EventItemMatterAttachments":[]},{"EventItemId":64889,"EventItemGuid":"407471B1-D175-4E53-9198-592BCAD184BF","EventItemLastModifiedUtc":"2026-07-15T20:07:25.013","EventItemRowVersion":"AAAAAASVFl8=","EventItemEventId":2651,"EventItemAgendaSequence":null,"EventItemMinutesSequence":2,"EventItemAgendaNumber":null,"EventItemVideo":null,"EventItemVideoIndex":null,"EventItemVersion":null,"EventItemAgendaNote":null,"EventItemMinutesNote":"{\\rtf1\\ansi\\ansicpg1252\\deff0\\deflang1033{\\fonttbl{\\f0\\fnil\\fcharset0 Arial;}}\r\n{\\colortbl ;\\red0\\green0\\blue0;}\r\n\\viewkind4\\uc1\\pard\\cf1\\fs28 Councilwoman Stark attended the meeting virtually.\\par\r\n\\par\r\nMayor Gallego acknowledged the presence of Mario Barajas and Elsie Duarte,\\par\r\nSpanish interpreters. In Spanish, Mr. Barajas announced their availability to the\\par\r\naudience.\\par\r\n\\par\r\nThe City Clerk confirmed copies of the titles of Ordinances G-7525 through G-7532; S-53065 through S-53089; and Resolutions 22388 through 22390 were available to the public in the office of the City Clerk at least 24 hours prior to this Council meeting, and therefore, may be read by title or agenda item only pursuant to the City Code.\\par\r\n\\par\r\nReferences to attachments in these minutes relate to documents that were\\par\r\nattached to the agenda.\\par\r\n\\par\r\nCity Attorney Julie Kriegh stated members of the public may speak for up to two\\par\r\nminutes on agenda items and gave direction on appropriate decorum when\\par\r\nproviding comments.\\par\r\n}\r\n","EventItemActionId":null,"EventItemActionName":null,"EventItemActionText":null,"EventItemPassedFlag":null,"EventItemPassedFlagName":null,"EventItemRollCallFlag":0,"EventItemFlagExtra":null,"EventItemTitle":null,"EventItemTally":null,"EventItemAccelaRecordId":null,"EventItemConsent":0,"EventItemMoverId":null,"EventItemMover":null,"EventItemSeconderId":null,"EventItemSeconder":null,"EventItemMatterId":null,"EventItemMatterGuid":null,"EventItemMatterFile":null,"EventItemMatterName":null,"EventItemMatterType":null,"EventItemMatterStatus":null,"EventItemMatterAttachments":[]},{"EventItemId":64890,"EventItemGuid":"C3C3DD77-FF11-452E-ACEE-20BBE6310966","EventItemLastModifiedUtc":"2026-07-15T19:30:46.933","EventItemRowVersion":"AAAAAASVFl8=","EventItemEventId":2651,"EventItemAgendaSequence":null,"EventItemMinutesSequence":7,"EventItemAgendaNumber":null,"EventItemVideo":null,"EventItemVideoIndex":null,"EventItemVersion":null,"EventItemAgendaNote":null,"EventItemMinutesNote":"{\\rtf1\\ansi\\ansicpg1252\\deff0\\deflang1033{\\fonttbl{\\f0\\fnil\\fcharset0 Arial;}}\r\n{\\colortbl ;\\red0\\green0\\blue0;}\r\n\\viewkind4\\uc1\\pard\\cf1\\fs28 Mayor Gallego administered the oath of office to the following appointees:\\par\r\n- Miriam Weisman, Human Relations Commission;\\par\r\n- Itoro Elijah and Audrey Jenkins, Human Services Commission;\\par\r\n- Alejandra Bucon and Patty Johnson, Library Advisory Board;\\par\r\n- Rafael Aviles Galaviz, Maryvale Village Planning Committee; and\\par\r\n- Christy Vezolles, Phoenix Arts and Culture Commission.\\par\r\n\\par\r\nMayor Gallego invited the above appointees to approach the dais so Council could extend their appreciation.\\par\r\n}\r\n","EventItemActionId":null,"EventItemActionName":null,"EventItemActionText":null,"EventItemPassedFlag":null,"EventItemPassedFlagName":null,"EventItemRollCallFlag":0,"EventItemFlagExtra":null,"EventItemTitle":null,"EventItemTally":null,"EventItemAccelaRecordId":null,"EventItemConsent":0,"EventItemMoverId":null,"EventItemMover":null,"EventItemSeconderId":null,"EventItemSeconder":null,"EventItemMatterId":null,"EventItemMatterGuid":null,"EventItemMatterFile":null,"EventItemMatterName":null,"EventItemMatterType":null,"EventItemMatterStatus":null,"EventItemMatterAttachments":[]},{"EventItemId":64891,"EventItemGuid":"78781C44-3D28-4955-9E24-8E33C02374A5","EventItemLastModifiedUtc":"2026-07-15T19:35:41.833","EventItemRowVersion":"AAAAAASVFl8=","EventItem