a Hodge Washington","EventItemSeconderId":1772,"EventItemSeconder":"Ann O'Brien","EventItemMatterId":null,"EventItemMatterGuid":null,"EventItemMatterFile":null,"EventItemMatterName":null,"EventItemMatterType":null,"EventItemMatterStatus":null,"EventItemMatterAttachments":[]},{"EventItemId":64820,"EventItemGuid":"A5A04029-389C-41F4-A2D1-B534C2D804E0","EventItemLastModifiedUtc":"2026-07-15T19:30:46.97","EventItemRowVersion":"AAAAAASVFl8=","EventItemEventId":2651,"EventItemAgendaSequence":51,"EventItemMinutesSequence":58,"EventItemAgendaNumber":"44","EventItemVideo":null,"EventItemVideoIndex":null,"EventItemVersion":"1","EventItemAgendaNote":null,"EventItemMinutesNote":null,"EventItemActionId":363,"EventItemActionName":"adopted","EventItemActionText":"This item was adopted.","EventItemPassedFlag":1,"EventItemPassedFlagName":"Pass","EventItemRollCallFlag":0,"EventItemFlagExtra":0,"EventItemTitle":"City of Glendale","EventItemTally":null,"EventItemAccelaRecordId":null,"EventItemConsent":1,"EventItemMoverId":null,"EventItemMover":null,"EventItemSeconderId":null,"EventItemSeconder":null,"EventItemMatterId":34572,"EventItemMatterGuid":"EDDEB375-23DA-4868-96F5-EE146E899B55","EventItemMatterFile":"26-0536","EventItemMatterName":null,"EventItemMatterType":"Payment Ordinance","EventItemMatterStatus":"Adopted","EventItemMatterAttachments":[]},{"EventItemId":64821,"EventItemGuid":"2F7D44E6-5A1E-4568-B09A-D1848A648335","EventItemLastModifiedUtc":"2026-07-15T19:30:46.97","EventItemRowVersion":"AAAAAASVFl8=","EventItemEventId":2651,"EventItemAgendaSequence":52,"EventItemMinutesSequence":59,"EventItemAgendaNumber":"45","EventItemVideo":null,"EventItemVideoIndex":null,"EventItemVersion":"1","EventItemAgendaNote":null,"EventItemMinutesNote":null,"EventItemActionId":363,"EventItemActionName":"adopted","EventItemActionText":"This item was adopted.","EventItemPassedFlag":1,"EventItemPassedFlagName":"Pass","EventItemRollCallFlag":0,"EventItemFlagExtra":0,"EventItemTitle":"City of Mesa","EventItemTally":null,"EventItemAccelaRecordId":null,"EventItemConsent":1,"EventItemMoverId":null,"EventItemMover":null,"EventItemSeconderId":null,"EventItemSeconder":null,"EventItemMatterId":34612,"EventItemMatterGuid":"1E8E2050-4D96-4603-A92F-870BBA00F46C","EventItemMatterFile":"26-0576","EventItemMatterName":null,"EventItemMatterType":"Payment Ordinance","EventItemMatterStatus":"Adopted","EventItemMatterAttachments":[]},{"EventItemId":64822,"EventItemGuid":"1E58DE2D-1425-405B-8051-050A3F449905","EventItemLastModifiedUtc":"2026-07-23T18:53:48.893","EventItemRowVersion":"AAAAAASVFl8=","EventItemEventId":2651,"EventItemAgendaSequence":53,"EventItemMinutesSequence":60,"EventItemAgendaNumber":"46","EventItemVideo":null,"EventItemVideoIndex":null,"EventItemVersion":"1","EventItemAgendaNote":null,"EventItemMinutesNote":null,"EventItemActionId":363,"EventItemActionName":"adopted","EventItemActionText":"This item was adopted.","EventItemPassedFlag":1,"EventItemPassedFlagName":"Pass","EventItemRollCallFlag":0,"EventItemFlagExtra":0,"EventItemTitle":"City of Mesa","EventItemTally":null,"EventItemAccelaRecordId":null,"EventItemConsent":1,"EventItemMoverId":null,"EventItemMover":null,"EventItemSeconderId":null,"EventItemSeconder":null,"EventItemMatterId":34613,"EventItemMatterGuid":"76E9886A-7666-4994-8C38-663DE739AAE7","EventItemMatterFile":"26-0577","EventItemMatterName":null,"EventItemMatterType":"Payment Ordinance","EventItemMatterStatus":"Adopted","EventItemMatterAttachments":[]},{"EventItemId":64848,"EventItemGuid":"B26993CE-6185-43B6-AD16-518B48D2F3FF","EventItemLastModifiedUtc":"2026-07-27T15:53:17.31","EventItemRowVersion":"AAAAAASVFl8=","EventItemEventId":2651,"EventItemAgendaSequence":81,"EventItemMinutesSequence":80,"EventItemAgendaNumber":"70","EventItemVideo":null,"EventItemVideoIndex":null,"EventItemVersion":"1","EventItemAgendaNote":null,"EventItemMinutesNote":null,"EventItemActionId":363,"EventItemActionName":"adopted","EventItemActionText":"This item was adopted.","EventItemPassedFlag":1,"EventItemPassedFlagName":"Pass","EventItemRollCallFlag":0,"EventItemFlagExtra":0,"EventItemTitle":"Electric Actuators Contract - IFB-26-0274 - Request for Award (Ordinance S-53066) - Citywide","EventItemTally":null,"EventItemAccelaRecordId":null,"EventItemConsent":1,"EventItemMoverId":null,"EventItemMover":null,"EventItemSeconderId":null,"EventItemSeconder":null,"EventItemMatterId":34861,"EventItemMatterGuid":"70273C69-FAD5-473A-AC38-10833A2CF7AB","EventItemMatterFile":"26-0825","EventItemMatterName":null,"EventItemMatterType":"Ordinance-S","EventItemMatterStatus":"Adopted","EventItemMatterAttachments":[]},{"EventItemId":64776,"EventItemGuid":"7822F21C-7CA2-456B-916A-BBEEBF7F2037","EventItemLastModifiedUtc":"2026-08-04T16:43:46.577","EventItemRowVersion":"AAAAAASVFl8=","EventItemEventId":2651,"EventItemAgendaSequence":41,"EventItemMinutesSequence":45,"EventItemAgendaNumber":"35","EventItemVideo":null,"EventItemVideoIndex":null,"EventItemVersion":"1","EventItemAgendaNote":null,"EventItemMinutesNote":"{\\rtf1\\ansi\\ansicpg1252\\deff0\\deflang1033{\\fonttbl{\\f0\\fnil\\fcharset0 Arial;}}\r\n{\\colortbl ;\\red0\\green0\\blue0;}\r\n\\viewkind4\\uc1\\pard\\cf1\\b\\fs28 Discussion\\b0\\par\r\nMayor Gallego noted there was a member from the public present to speak. \\par\r\n\\par\r\nAlliance Zawadi claimed the police report had incorrect information, noting that the restaurant no longer had a stage, exterior signage did not reference private parties or live entertainment, neighboring businesses had not reported noise issues, and food sales met forty percent. She stated that an incident on May 30 was a private family graduation dinner and not a party.\\par\r\n\\par\r\nCommunity Action Officer Jeremy Campbell with the Black Mountain Precinct reported that interior features, food supply, and the business\\rquote s operations were inconsistent with the requirements of a Series 12 restaurant license. He noted concerns raised by neighboring businesses, inconsistencies between the application and on-site observations, and multiple police calls that confirmed late-night gatherings and noise. He stated that the Police Department stood by their initial disapproval.\\par\r\n\\par\r\n\\b Motion was made by Councilman Waring to disapprove this item. The motion was seconded by Councilwoman O'Brien.\\b0\\par\r\n\\par\r\nMayor Gallego asked if the entire reason for disapproval was necessary.\\par\r\n\\par\r\nDeputy City Clerk Kristen Lecuyer-Benavidez responded it was not unless the Council required it.\\par\r\n}\r\n","EventItemActionId":366,"EventItemActionName":"recommended for denial","EventItemActionText":"A motion was made by Councilman Waring, seconded by Councilwoman O'Brien, that this item be recommended for disapproval. The motion carried by the following vote:","EventItemPassedFlag":1,"EventItemPassedFlagName":"Pass","EventItemRollCallFlag":0,"EventItemFlagExtra":0,"EventItemTitle":"Liquor License - Garden of Eden Grill - District 2","EventItemTally":null,"EventItemAccelaRecordId":null,"EventItemConsent":0,"EventItemMoverId":192,"EventItemMover":"Jim Waring","EventItemSeconderId":1772,"EventItemSeconder":"Ann O'Brien","EventItemMatterId":34929,"EventItemMatterGuid":"412F5D50-43D6-4FE4-AE5B-2E4251DCEFB2","EventItemMatterFile":"26-0893","EventItemMatterName":null,"EventItemMatterType":"License - Liquor","EventItemMatterStatus":"Recommended for Disapproval","EventItemMatterAttachments":[{"MatterAttachmentId":72495,"MatterAttachmentGuid":"742F1A12-AAD5-4066-B576-4BBE6B34C96B","MatterAttachmentLastModifiedUtc":"2026-04-14T17:13:35.81","MatterAttachmentRowVersion":"AAAAAASMqDk=","MatterAttachmentName":"Attachment A - Garden of Eden Grill - Data.pdf","MatterAttachmentHyperlink":"https://phoenix.legistar1.com/phoenix/attachments/df8b56d2-058a-4a6c-92f3-1ff9bf8faee9.pdf","MatterAttachmentFileName":"df8b56d2-058a-4a6c-92f3-1ff9bf8faee9.pdf","MatterAttachmentMatterVersion":"0","MatterAttachmentIsHyperlink":false,"MatterAt