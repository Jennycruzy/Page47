owOnInternetPage":true,"MatterAttachmentIsMinuteOrder":false,"MatterAttachmentIsBoardLetter":false,"MatterAttachmentAgiloftId":0,"MatterAttachmentDescription":null,"MatterAttachmentPrintWithReports":false,"MatterAttachmentSort":-2147483648},{"MatterAttachmentId":73876,"MatterAttachmentGuid":"A984A814-D747-4ED4-A196-07E3003DAA54","MatterAttachmentLastModifiedUtc":"2026-06-17T23:13:48.173","MatterAttachmentRowVersion":"AAAAAASMkRQ=","MatterAttachmentName":"Attachment B - Strip Mall - Map.pdf","MatterAttachmentHyperlink":"https://phoenix.legistar1.com/phoenix/attachments/d105b1e3-35de-4ee6-80b9-6194498757e7.pdf","MatterAttachmentFileName":"d105b1e3-35de-4ee6-80b9-6194498757e7.pdf","MatterAttachmentMatterVersion":"0","MatterAttachmentIsHyperlink":false,"MatterAttachmentBinary":null,"MatterAttachmentIsSupportingDocument":false,"MatterAttachmentShowOnInternetPage":true,"MatterAttachmentIsMinuteOrder":false,"MatterAttachmentIsBoardLetter":false,"MatterAttachmentAgiloftId":0,"MatterAttachmentDescription":null,"MatterAttachmentPrintWithReports":false,"MatterAttachmentSort":-2147483648}]},{"EventItemId":64806,"EventItemGuid":"81DD6468-FA43-4EA4-9995-F61CB9AC6709","EventItemLastModifiedUtc":"2026-07-27T15:30:43.783","EventItemRowVersion":"AAAAAASVFl8=","EventItemEventId":2651,"EventItemAgendaSequence":36,"EventItemMinutesSequence":40,"EventItemAgendaNumber":"30","EventItemVideo":null,"EventItemVideoIndex":null,"EventItemVersion":"1","EventItemAgendaNote":null,"EventItemMinutesNote":null,"EventItemActionId":365,"EventItemActionName":"recommended for approval","EventItemActionText":"This item was recommended for approval.","EventItemPassedFlag":1,"EventItemPassedFlagName":"Pass","EventItemRollCallFlag":0,"EventItemFlagExtra":0,"EventItemTitle":"Liquor License - QuikTrip # 1535 - District 7","EventItemTally":null,"EventItemAccelaRecordId":null,"EventItemConsent":1,"EventItemMoverId":null,"EventItemMover":null,"EventItemSeconderId":null,"EventItemSeconder":null,"EventItemMatterId":35502,"EventItemMatterGuid":"39B5CD38-7DFC-4FC7-99DC-7625FFBC6C6E","EventItemMatterFile":"26-1467","EventItemMatterName":null,"EventItemMatterType":"License - Liquor","EventItemMatterStatus":"Recommended for Approval","EventItemMatterAttachments":[{"MatterAttachmentId":73879,"MatterAttachmentGuid":"93304E7F-5E7D-4DF8-B180-25BD9598E8F1","MatterAttachmentLastModifiedUtc":"2026-06-18T17:26:18.937","MatterAttachmentRowVersion":"AAAAAASMkU4=","MatterAttachmentName":"Attachment A - Quiktrip #1535 - Data.pdf","MatterAttachmentHyperlink":"https://phoenix.legistar1.com/phoenix/attachments/39657440-025f-4ff1-b9cc-1f334242567c.pdf","MatterAttachmentFileName":"39657440-025f-4ff1-b9cc-1f334242567c.pdf","MatterAttachmentMatterVersion":"0","MatterAttachmentIsHyperlink":false,"MatterAttachmentBinary":null,"MatterAttachmentIsSupportingDocument":false,"MatterAttachmentShowOnInternetPage":true,"MatterAttachmentIsMinuteOrder":false,"MatterAttachmentIsBoardLetter":false,"MatterAttachmentAgiloftId":0,"MatterAttachmentDescription":null,"MatterAttachmentPrintWithReports":false,"MatterAttachmentSort":-2147483648},{"MatterAttachmentId":73880,"MatterAttachmentGuid":"2DF2B346-482C-410B-9ABC-0A7BCBA0F46B","MatterAttachmentLastModifiedUtc":"2026-06-18T17:26:27.743","MatterAttachmentRowVersion":"AAAAAASMkXU=","MatterAttachmentName":"Attachment B - Quiktrip #1535 - Map.pdf","MatterAttachmentHyperlink":"https://phoenix.legistar1.com/phoenix/attachments/1ce484a0-dbaf-4a59-8983-064bedfa0cf0.pdf","MatterAttachmentFileName":"1ce484a0-dbaf-4a59-8983-064bedfa0cf0.pdf","MatterAttachmentMatterVersion":"0","MatterAttachmentIsHyperlink":false,"MatterAttachmentBinary":null,"MatterAttachmentIsSupportingDocument":false,"MatterAttachmentShowOnInternetPage":true,"MatterAttachmentIsMinuteOrder":false,"MatterAttachmentIsBoardLetter":false,"MatterAttachmentAgiloftId":0,"MatterAttachmentDescription":null,"MatterAttachmentPrintWithReports":false,"MatterAttachmentSort":-2147483648}]},{"EventItemId":64835,"EventItemGuid":"1E7A10C5-E933-433E-B0D8-FDB93FA1CEE6","EventItemLastModifiedUtc":"2026-08-04T17:17:40.877","EventItemRowVersion":"AAAAAASVFl8=","EventItemEventId":2651,"EventItemAgendaSequence":104,"EventItemMinutesSequence":105,"EventItemAgendaNumber":"91","EventItemVideo":null,"EventItemVideoIndex":null,"EventItemVersion":"1","EventItemAgendaNote":null,"EventItemMinutesNote":"{\\rtf1\\ansi\\ansicpg1252\\deff0\\deflang1033{\\fonttbl{\\f0\\fnil\\fcharset0 Arial;}}\r\n{\\colortbl ;\\red0\\green0\\blue0;}\r\n\\viewkind4\\uc1\\pard\\cf1\\b\\fs28 Discussion\\par\r\n\\b0 Jerry Van Gasse, the applicant of the citizen petition, introduced himself to the Council. He was requesting the renaming of Cesar Chavez Park in honor of Olympian and humanitarian Jesse Owens, who lived his final decade in Phoenix. Mr. Van Gasse noted this request was previously raised during the Council\\rquote s March 25 direction to rename items associated with Cesar Chavez. He referenced Mr. Owens\\rquote s historic Olympic achievements, his medals being displayed nationally during the Bicentennial celebration, and his recognition by USA Today as the most important athlete in the nation\\rquote s 250-year history. Mr. Van Gasse emphasized Mr. Owens ties to Phoenix and asked the Council to honor him by renaming the park.\\par\r\n\\par\r\nVice Mayor Hodge Washington asked if the end goal was for the City to honor Jesse Owens.\\par\r\n\\par\r\nMr. Van Gasse confirmed that statement.\\par\r\n\\par\r\nJeremy Thacker reflected on the significance of park names in helping residents understand Phoenix\\rquote s history. He stated that renaming Cesar Chavez Park after Jesse Owens would honor Mr. Owens legacy of perseverance and excellence. Mr. Thacker noted names communicate community values and that future generations might learn Mr. Owens story by encountering his name in public spaces. Mr. Thacker concluded that renaming the park could have meaningful impact for the community.\\par\r\n\\par\r\nVice Mayor Hodge Washington expressed her appreciation to Jerry Van Gasse for highlighting Jesse Owens legacy and noted the significance of seeing Mr. Owens medals following a recent subcommittee meeting. She described Jesse Owens as an extraordinary athlete and American whose perseverance and advocacy for civil rights merit recognition. She stated the City should continue seeking the opportunity to honor historical figures. She emphasized the importance of respecting the community engagement process and cited the Parks and Recreation Department\\rquote s long outreach effort which concluded the name Aguila Park and Community Center had the most support throughout the renaming process. She acknowledged the expressed concerns and said she hoped for intentional approaches to honoring Jesse Owens and other deserving individuals across the City.\\par\r\n\\par\r\n\\b Motion was made by Vice Mayor Hodge Washington to deny the petition with direction to staff. The motion was seconded by Councilwoman Guardado.\\b0\\par\r\n\\par\r\nCouncilwoman Hernandez expressed her concerns with the renaming process. She stated that removing Cesar Chavez\\rquote s name should not erase the history of the farmworkers\\rquote  movement. She emphasized the proposed names, Aguila and Laveen, did not reflect that legacy. She noted Jesse Owens\\rquote  historic accomplishments, his fight against racism, and his connection to Phoenix, and said she supports the citizen petition to rename the park after Mr. Owens. She thanked the Mayor and Vice Mayor, but said she could not support the staff recommended options because she felt they would diminish farmworker history in the area.\\par\r\n}\r\n","EventItemActionId":389,"EventItemActionName":"denied","EventItemActionText":"A motion was made by Vice Mayor Hodge Washington, seconded by Councilwoman Guardado, to deny the petition with direction to staff to conduct a process to identify a way to honor Jesse Owens and potentially other historical figures to Phoenix and return with an update to the relevant City Council Subcommittee by the end of 2026. The motion carried by the following vote:","EventItemPassedFlag":1,"EventItemPassedFlagName":"Pass","EventItemRollCallFlag":0,"EventItemFlagExtra":0,"EventItemTitle":"Consideration of a Citizen Petition Submitted by Mr. Jerry Van Gasse - District 8","EventItemTally":null,"EventItemAccelaRecordId":null,"EventItemConsent":0,"EventItemMoverId":2022,"EventItemMover":"Kesha Hodge Washington","EventItemSeconderId":1617,"EventItemSeconder":"Betty Guardado","EventItemMatterId":35513,"EventItemMatterGuid":"3F5A4B75-772E-43DA-8B58-3FA98FF1505F","EventItemMatterFile":"26-1478","EventItemMatterName":null,"EventItemMatterType":"Formal Action","EventItemMatterStatus":"Agenda Ready - Parks and Recreation Department","EventItemMatterAttachments":[{"MatterAttachmentId":73902,"MatterAttachmentGuid":"27AE3FC5-9282-49D3-AA94-79D312C539CA","MatterAttachmentLastModifiedUtc":"2026-06-23T17:38:16.18","MatterAttachmentRowVersion":"AAAAAASMXxY=","MatterAttachmentName":"Attachment A - Citizen Petition Renaming Cesar Chavez Park and Facility.pdf","MatterAttachmentHyperlink":"https://phoenix.legistar1.com/phoenix/attachments/f12be446-3801-4599-b02a-c006edc3f874.pdf","MatterAttachmentFileName":"f12be446-3801-4599-b02a-c006edc3f874.pdf","MatterAttachmentMatterVersion":"0","MatterAttachmentIsHyperlink":false,"MatterAttachmentBinary":null,"MatterAttachmentIsSupportingDocument":false,"MatterAttachmentShowOnInternetPage":true,"MatterAttachmentIsMinuteOrder":false,"MatterAttachmentIsBoardLetter":false,"MatterAttachmentAgiloftId":0,"MatterAttachmentDescription":null,"MatterAttachmentPrintWithReports":false,"MatterAttachmentSort":-2147483648},{"MatterAttachmentId":73903,"MatterAttachmentGuid":"CDE2B5A3-635D-44EE-884C-FFB306A96758","MatterAttachmentLastModifiedUtc":"2026-06-23T18:11:48.1","MatterAttachmentRowVersion":"AAAAAASNanY=","MatterAttachmentName":"Attachment B - Renaming Survey-Summary - Copy.pdf","MatterAttachmentHyperlink":"https://phoenix.legistar1.com/phoenix/attachments/94715c7b-c50b-4e31-8dc4-b665b2863559.pdf","MatterAttachmentFileName":"94715c7b-c50b-4e31-8dc4-b665b2863559.pdf","MatterAttachmentMatterVersion":"0","MatterAttachmentIsHyperlink":false,"MatterAttachmentBinary":null,"MatterAttachmentIsSupportingDocument":false,"MatterAttachmentShowOnInternetPage":true,"MatterAttachmentIsMinuteOrder":false,"MatterAttachmentIsBoardLetter":false,"MatterAttachmentAgiloftId":0,"MatterAttachmentDescription":null,"MatterAttachmentPrintWithReports":false,"MatterAttachmentSort":-2147483648}]}]}