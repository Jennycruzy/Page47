atterFile":"26-1360","EventItemMatterName":null,"EventItemMatterType":"License - Liquor","EventItemMatterStatus":"Recommended for Approval","EventItemMatterAttachments":[]},{"EventItemId":64882,"EventItemGuid":"98929850-FC02-46A2-828C-8120CA8D6963","EventItemLastModifiedUtc":"2026-07-15T19:30:46.93","EventItemRowVersion":"AAAAAASVFl8=","EventItemEventId":2651,"EventItemAgendaSequence":4,"EventItemMinutesSequence":4,"EventItemAgendaNumber":"1","EventItemVideo":null,"EventItemVideoIndex":null,"EventItemVersion":"1","EventItemAgendaNote":null,"EventItemMinutesNote":null,"EventItemActionId":383,"EventItemActionName":"approved","EventItemActionText":"A motion was made by Councilwoman Guardado, seconded by Vice Mayor Hodge Washington, that this item be approved. The motion carried by the following voice vote:","EventItemPassedFlag":1,"EventItemPassedFlagName":"Pass","EventItemRollCallFlag":0,"EventItemFlagExtra":null,"EventItemTitle":"For Approval or Correction, the Minutes of the Formal Meeting on November 19, 2025","EventItemTally":null,"EventItemAccelaRecordId":null,"EventItemConsent":0,"EventItemMoverId":1617,"EventItemMover":"Betty Guardado","EventItemSeconderId":2022,"EventItemSeconder":"Kesha Hodge Washington","EventItemMatterId":35396,"EventItemMatterGuid":"53ADAE71-1AAD-45EF-AF25-61AF4512C1B3","EventItemMatterFile":"26-1361","EventItemMatterName":null,"EventItemMatterType":"Minutes","EventItemMatterStatus":"Approved","EventItemMatterAttachments":[]},{"EventItemId":64774,"EventItemGuid":"64E96BB1-3A11-4005-94EC-1E035601B53F","EventItemLastModifiedUtc":"2026-08-04T16:43:25.42","EventItemRowVersion":"AAAAAASVFl8=","EventItemEventId":2651,"EventItemAgendaSequence":6,"EventItemMinutesSequence":6,"EventItemAgendaNumber":"2","EventItemVideo":null,"EventItemVideoIndex":null,"EventItemVersion":"1","EventItemAgendaNote":null,"EventItemMinutesNote":"{\\rtf1\\ansi\\ansicpg1252\\deff0\\deflang1033{\\fonttbl{\\f0\\fnil\\fcharset0 Arial;}}\r\n{\\colortbl ;\\red0\\green0\\blue0;}\r\n\\viewkind4\\uc1\\pard\\cf1\\fs28 The following individuals were recommended for appointment/reappointment by Mayor Gallego and Councilmembers.\\par\r\n\\par\r\n\\ul Human Relations Commission\\par\r\n\\ulnone Appoint Miriam Weisman, to serve as Chair, for a term to expire July 1, 2027, as recommended by Mayor Gallego.\\par\r\n\\par\r\n\\ul Human Services Commission\\ulnone\\par\r\nReappoint Sheriolyn Curry, to serve a third term to expire June 30, 2029, as recommended by Mayor Gallego.\\par\r\n\\par\r\nReappoint Itoro Elijah, to serve a third term to expire June 30, 2029, as recommended by Mayor Gallego.\\par\r\n\\par\r\nReappoint Elisha Franklin, to serve a second term to expire June 30, 2029, as recommended by Mayor Gallego.\\par\r\n\\par\r\nReappoint Audrey Jenkins, to serve a third term to expire June 30, 2029, as recommended by Mayor Gallego.\\par\r\n\\par\r\nReappoint Gail Knight, to serve a second term to expire June 30, 2029, as recommended by Mayor Gallego.\\par\r\n\\par\r\n\\ul Library Advisory Board\\par\r\n\\ulnone Appoint Alejandra Bucon, filling a vacancy, for a term to expire July 1, 2029, as recommended by Mayor Gallego.\\par\r\n\\par\r\nAppoint Patty Johnson, filling a vacancy, for a term to expire July 1, 2029, as recommended by Mayor Gallego.\\par\r\n\\par\r\n\\ul Maryvale Village Planning Committee\\par\r\n\\ulnone Rafael Aviles Galaviz, filling a vacancy, for a term to expire July 1, 2028, as recommended by Councilwoman Guardado.\\par\r\n\\par\r\n\\ul Neighborhood Block Watch Fund Oversight Committee\\par\r\n\\ulnone Appoint Marnie Hawkins, filling a vacancy, for a term to expire July 1, 2028, as recommended by Councilwoman O'Brien.\\par\r\n\\par\r\n\\ul Phoenix Arts and Culture Commission\\par\r\n\\ulnone Appoint Christy Vezolles, filling a vacancy, for a term to expire July 1, 2029, as recommended by Mayor Gallego.\\par\r\n\\par\r\n\\ul Public Safety Personnel Retirement System Local Fire Pension Board\\par\r\n\\ulnone Appoint Cris Meyer, as a representative of the Civil Service Board recently elected as Chairperson, replacing Donna McHenry, as recommended by Mayor Gallego.\\par\r\n\\par\r\nAppoint Brian Moore, Captain with the Phoenix Fire Department, as a representative of sworn Fire Department employees, for a full term to expire June 30, 2030, as recommended by Mayor Gallego.\\par\r\n\\par\r\nAppoint Corey Moos, Fire Engineer with the Phoenix Fire Department, as a representative of sworn Fire Department employees, replacing Brian Saylor, for a term to expire June 30, 2028, as recommended by Mayor Gallego.\\par\r\n\\par\r\n\\ul Public Safety Personnel Retirement System Local Police Pension Board\\par\r\n\\ulnone Appoint Cris Meyer, as a representative of the Civil Service Board recently elected as Chairperson, replacing Donna McHenry, as recommended by Mayor Gallego.\\par\r\n\\par\r\nAppoint Santos Robles, Police Officer with the Phoenix Police Department, as a representative of sworn Police Department employees, for a term to expire June 30, 2030, as recommended by Mayor Gallego.\\par\r\n}\r\n","EventItemActionId":367,"EventItemActionName":"approved as amended","EventItemActionText":"A motion was made by Vice Mayor Hodge Washington, seconded by Councilwoman O'Brien, that this item be approved as amended. The motion carried by the following vote:","EventItemPassedFlag":1,"EventItemPassedFlagName":"Pass","EventItemRollCallFlag":0,"EventItemFlagExtra":0,"EventItemTitle":"Mayor and Council Appointments to Boards and Commissions","EventItemTally":null,"EventItemAccelaRecordId":null,"EventItemConsent":0,"EventItemMoverId":2022,"EventItemMover":"Kesha Hodge Washington","EventItemSeconderId":1772,"EventItemSeconder":"Ann O'Brien","EventItemMatterId":35397,"EventItemMatterGuid":"7A403AD3-04E5-4AB7-8A8E-F741981418D5","EventItemMatterFile":"26-1362","EventItemMatterName":null,"EventItemMatterType":"Board & Commission","EventItemMatterStatus":"Passed","EventItemMatterAttachments":[{"MatterAttachmentId":73937,"MatterAttachmentGuid":"4544A75F-526C-47C1-BEF2-95869EA49071","MatterAttachmentLastModifiedUtc":"2026-06-29T18:02:22.05","MatterAttachmentRowVersion":"AAAAAASbZtI=","MatterAttachmentName":"Attachment A - Revised Boards and Commissions Appointments.pdf","MatterAttachmentHyperlink":"https://phoenix.legistar1.com/phoenix/attachments/6182fc1f-cfcd-40a6-b4c5-beef2c152dc0.pdf","MatterAttachmentFileName":"6182fc1f-cfcd-40a6-b4c5-beef2c152dc0.pdf","MatterAttachmentMatterVersion":"0","MatterAttachmentIsHyperlink":false,"MatterAttachmentBinary":null,"MatterAttachmentIsSupportingDocument":false,"MatterAttachmentShowOnInternetPage":true,"MatterAttachmentIsMinuteOrder":false,"MatterAttachmentIsBoardLetter":false,"MatterAttachmentAgiloftId":0,"MatterAttachmentDescription":null,"MatterAttachmentPrintWithReports":false,"MatterAttachmentSort":-2147483648}]},{"EventItemId":64874,"EventItemGuid":"B131CE83-5AB0-42B2-A9FB-C3F1D329CBF7","EventItemLastModifiedUtc":"2026-07-15T19:30:46.993","EventItemRowVersion":"AAAAAASVFl8=","EventItemEventId":2651,"EventItemAgendaSequence":92,"EventItemMinutesSequence":88,"EventItemAgendaNumber":"80","EventItemVideo":null,"EventItemVideoIndex":null,"EventItemVersion":"1","EventItemAgendaNote":null,"EventItemMinutesNote":null,"EventItemActionId":363,"EventItemActionName":"adopted","EventItemActionText":"This item was adopted.","EventItemPassedFlag":1,"EventItemPassedFlagName":"Pass","EventItemRollCallFlag":0,"EventItemFlagExtra":null,"EventItemTitle":"Amend City Code - Ordinance Adoption - Rezoning Application Z-145-24-1 - Approximately 200 Feet North of the Northwest Corner of 35th Avenue and Bell Road (Ordinance G-7528) - District 1","EventItemTally":null,"EventItemAccelaRecordId":null,"EventItemConsent":1,"EventItemMoverId":null,"EventItemMover":null,"EventItemSeconderId":null,"EventItemSeconder":null,"EventItemMatterId":35398,"EventItemMatterGuid":"FEF16381-BDB7-417F-9775-817F2EF84235","EventItemMatterFile":"26-1363","EventItemMatterName":null,"Ev