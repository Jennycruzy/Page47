AAAAASMAeQ=","MatterAttachmentName":"Attachment D - PC Summary - Z-145-24-1.pdf","MatterAttachmentHyperlink":"https://phoenix.legistar1.com/phoenix/attachments/d500a644-34df-438c-9a6d-a352c041efc8.pdf","MatterAttachmentFileName":"d500a644-34df-438c-9a6d-a352c041efc8.pdf","MatterAttachmentMatterVersion":"0","MatterAttachmentIsHyperlink":false,"MatterAttachmentBinary":null,"MatterAttachmentIsSupportingDocument":false,"MatterAttachmentShowOnInternetPage":true,"MatterAttachmentIsMinuteOrder":false,"MatterAttachmentIsBoardLetter":false,"MatterAttachmentAgiloftId":0,"MatterAttachmentDescription":null,"MatterAttachmentPrintWithReports":false,"MatterAttachmentSort":-2147483648},{"MatterAttachmentId":73910,"MatterAttachmentGuid":"5C66AAEC-1187-4428-8DA1-A068C5444E24","MatterAttachmentLastModifiedUtc":"2026-06-24T17:24:48.48","MatterAttachmentRowVersion":"AAAAAASNYfE=","MatterAttachmentName":"Attachment A - Draft Ordinance - Z-145-24-1.pdf","MatterAttachmentHyperlink":"https://phoenix.legistar1.com/phoenix/attachments/9b7c3f28-2f09-4519-b830-429db2cd6361.pdf","MatterAttachmentFileName":"9b7c3f28-2f09-4519-b830-429db2cd6361.pdf","MatterAttachmentMatterVersion":"0","MatterAttachmentIsHyperlink":false,"MatterAttachmentBinary":null,"MatterAttachmentIsSupportingDocument":false,"MatterAttachmentShowOnInternetPage":true,"MatterAttachmentIsMinuteOrder":false,"MatterAttachmentIsBoardLetter":false,"MatterAttachmentAgiloftId":0,"MatterAttachmentDescription":null,"MatterAttachmentPrintWithReports":false,"MatterAttachmentSort":-2147483648}]},{"EventItemId":64876,"EventItemGuid":"24B8222F-370C-4227-8A6B-B164990518FA","EventItemLastModifiedUtc":"2026-07-15T19:30:46.997","EventItemRowVersion":"AAAAAASVFl8=","EventItemEventId":2651,"EventItemAgendaSequence":95,"EventItemMinutesSequence":91,"EventItemAgendaNumber":"83","EventItemVideo":null,"EventItemVideoIndex":null,"EventItemVersion":"1","EventItemAgendaNote":null,"EventItemMinutesNote":null,"EventItemActionId":370,"EventItemActionName":"withdrawn","EventItemActionText":"This item was withdrawn.","EventItemPassedFlag":1,"EventItemPassedFlagName":"Pass","EventItemRollCallFlag":0,"EventItemFlagExtra":null,"EventItemTitle":"***REQUEST TO WITHDRAW (SEE ATTACHED MEMO)*** Formal Action - PCD Major Amendment - Rezoning Application Z-104-L-75-3 - Southeast Corner of Interstate 17 and Grandview Road - District 3","EventItemTally":null,"EventItemAccelaRecordId":null,"EventItemConsent":1,"EventItemMoverId":null,"EventItemMover":null,"EventItemSeconderId":null,"EventItemSeconder":null,"EventItemMatterId":35399,"EventItemMatterGuid":"C034831C-34F9-476F-836F-77AFAE898913","EventItemMatterFile":"26-1364","EventItemMatterName":null,"EventItemMatterType":"Formal Action","EventItemMatterStatus":"Passed","EventItemMatterAttachments":[{"MatterAttachmentId":73758,"MatterAttachmentGuid":"FAE2E91C-E52D-468B-8A48-0B9E989AB69A","MatterAttachmentLastModifiedUtc":"2026-06-09T19:06:45.57","MatterAttachmentRowVersion":"AAAAAASMtD0=","MatterAttachmentName":"Attachment B - Staff Report - Z-104-L-75-3.pdf","MatterAttachmentHyperlink":"https://phoenix.legistar1.com/phoenix/attachments/d8b8f5d3-5d9d-4df0-a790-da325457b206.pdf","MatterAttachmentFileName":"d8b8f5d3-5d9d-4df0-a790-da325457b206.pdf","MatterAttachmentMatterVersion":"0","MatterAttachmentIsHyperlink":false,"MatterAttachmentBinary":null,"MatterAttachmentIsSupportingDocument":false,"MatterAttachmentShowOnInternetPage":true,"MatterAttachmentIsMinuteOrder":false,"MatterAttachmentIsBoardLetter":false,"MatterAttachmentAgiloftId":0,"MatterAttachmentDescription":null,"MatterAttachmentPrintWithReports":false,"MatterAttachmentSort":-2147483648},{"MatterAttachmentId":73759,"MatterAttachmentGuid":"469F3F3E-BFE2-44EA-9EA8-DFE816D47266","MatterAttachmentLastModifiedUtc":"2026-06-09T19:06:46.127","MatterAttachmentRowVersion":"AAAAAASMtD4=","MatterAttachmentName":"Attachment C - VPC Summary - Z-104-L-75-3.pdf","MatterAttachmentHyperlink":"https://phoenix.legistar1.com/phoenix/attachments/d7a