Id":null,"EventItemSeconder":null,"EventItemMatterId":35484,"EventItemMatterGuid":"79C66B17-CE45-4E81-B14F-961F439927E1","EventItemMatterFile":"26-1449","EventItemMatterName":null,"EventItemMatterType":"Payment Ordinance","EventItemMatterStatus":"Adopted","EventItemMatterAttachments":[]},{"EventItemId":64808,"EventItemGuid":"0EF72909-1AFA-42D7-AC56-20F9AB761086","EventItemLastModifiedUtc":"2026-07-15T19:30:46.95","EventItemRowVersion":"AAAAAASVFl8=","EventItemEventId":2651,"EventItemAgendaSequence":23,"EventItemMinutesSequence":27,"EventItemAgendaNumber":"17","EventItemVideo":null,"EventItemVideoIndex":null,"EventItemVersion":"1","EventItemAgendaNote":null,"EventItemMinutesNote":null,"EventItemActionId":365,"EventItemActionName":"recommended for approval","EventItemActionText":"This item was recommended for approval.","EventItemPassedFlag":1,"EventItemPassedFlagName":"Pass","EventItemRollCallFlag":0,"EventItemFlagExtra":0,"EventItemTitle":"Liquor License - Special Event - WayneFest - District 4","EventItemTally":null,"EventItemAccelaRecordId":null,"EventItemConsent":1,"EventItemMoverId":null,"EventItemMover":null,"EventItemSeconderId":null,"EventItemSeconder":null,"EventItemMatterId":35493,"EventItemMatterGuid":"2187F5D0-C651-443B-AD05-EC7E8647BC7A","EventItemMatterFile":"26-1458","EventItemMatterName":null,"EventItemMatterType":"License - Special Event","EventItemMatterStatus":"Recommended for Approval","EventItemMatterAttachments":[]},{"EventItemId":64804,"EventItemGuid":"F5A91923-EA15-4F72-80D7-70D76CEE2D72","EventItemLastModifiedUtc":"2026-07-23T18:27:46.457","EventItemRowVersion":"AAAAAASVFl8=","EventItemEventId":2651,"EventItemAgendaSequence":31,"EventItemMinutesSequence":35,"EventItemAgendaNumber":"25","EventItemVideo":null,"EventItemVideoIndex":null,"EventItemVersion":"1","EventItemAgendaNote":null,"EventItemMinutesNote":null,"EventItemActionId":365,"EventItemActionName":"recommended for approval","EventItemActionText":"This item was recommended for approval.","EventItemPassedFlag":1,"EventItemPassedFlagName":"Pass","EventItemRollCallFlag":0,"EventItemFlagExtra":0,"EventItemTitle":"Liquor License - RBG Spirits and Wine of Arizona - District 6","EventItemTally":null,"EventItemAccelaRecordId":null,"EventItemConsent":1,"EventItemMoverId":null,"EventItemMover":null,"EventItemSeconderId":null,"EventItemSeconder":null,"EventItemMatterId":35494,"EventItemMatterGuid":"C4018496-889E-4153-A4D9-4BF1558F47DE","EventItemMatterFile":"26-1459","EventItemMatterName":null,"EventItemMatterType":"License - Liquor","EventItemMatterStatus":"Recommended for Approval","EventItemMatterAttachments":[]},{"EventItemId":64880,"EventItemGuid":"FF77FC27-374C-4F74-941A-DC7EE58AF91A","EventItemLastModifiedUtc":"2026-08-04T16:58:24.8","EventItemRowVersion":"AAAAAASVFl8=","EventItemEventId":2651,"EventItemAgendaSequence":101,"EventItemMinutesSequence":103,"EventItemAgendaNumber":"89","EventItemVideo":null,"EventItemVideoIndex":null,"EventItemVersion":"1","EventItemAgendaNote":null,"EventItemMinutesNote":"{\\rtf1\\ansi\\ansicpg1252\\deff0\\deflang1033{\\fonttbl{\\f0\\fnil\\fcharset0 Arial;}}\r\n{\\colortbl ;\\red0\\green0\\blue0;}\r\n\\viewkind4\\uc1\\pard\\cf1\\b\\fs28 Discussion\\par\r\n\\b0 Mayor Gallego noted there were residents present to speak on the item.\\par\r\n\\par\r\nMike Marciano expressed his support for this item.\\par\r\n\\par\r\nLuis Orduno expressed his opposition to this item.\\par\r\n\\par\r\nMayor Gallego asked if Mr. Orduno worked for a service provider to the data center industry.\\par\r\n\\par\r\nMr. Orduno responded he did not as he was just a resident.\\par\r\n\\par\r\nMayor Gallego clarified that he lived near a data center and thanked him for taking the time to testify.\\par\r\n\\par\r\nAlex Johnson expressed his opposition to this item.\\par\r\n\\par\r\nThomas Branch expressed his opposition to this item.\\par\r\n\\par\r\nNOTE: Councilman Waring briefly left the meeting and returned at the end of Mr. Branch's testimony.\\par\r\n\\par\r\nNOTE: Two electronic comments were submitted for the record in opposition to this item.\\par\r\n\\par\r\nMayor Gallego invited the applicant's representative to the podium to answer questions. She asked how many jobs would be created on site of the proposal post construction.\\par\r\n\\par\r\nJason Morris stated the creation of 30-50 jobs was the long-term expected range.\\par\r\n\\par\r\nMayor Gallego asked if his client would be paying the traditional sales tax rate or using the State of Arizona's generous sales tax incentive.\\par\r\n\\par\r\nMr. Morris replied such incentives must be applied for by the property owner and that he was unaware whether an application had been submitted. He provided background on the site, explaining the project originated as a 2024 application for adaptive reuse of an existing building. He noted the property is relatively small for a data center, approximately 7 acres with a planned 20-megawatt capacity, in comparison to larger projects.\\par\r\n\\par\r\nMr. Morris stated the applicant previously coordinated with Planning and Development staff, Community and Economic Development staff, and APS, but paused development while working with new tenants. He added during that period, the City adopted a comprehensive data center ordinance making new data center development generally subject to stricter land-use requirements. He explained this site is one of the few remaining properties eligible to proceed under earlier rules and is now continuing through the waiver process due to its existing zoning. He added that the building has been vacant and broken into multiple times over the past two years, and the intent is to establish a viable, small use in the existing building.\\par\r\n\\par\r\nMayor Gallego asked for confirmation that the site would not require any new electric transmission but rather would be able to use the existing grid capacity.\\par\r\n\\par\r\nMr. Morris confirmed that was correct and the applicant would be extending underground to existing lines.\\par\r\n\\par\r\nMayor Gallego asked for confirmation the site would not disrupt any of the surrounding neighborhoods.\\par\r\n\\par\r\nMr. Morris confirmed that statement.\\par\r\n\\par\r\nMayor Gallego stated that although the site has advantages, she is concerned for the residential properties that border two sides of the location. She referenced a previous lithium battery fire early in her career as mayor that resulted in serious injuries to firefighters, noting fire code now requires allowing lithium battery fires to burn out. She expressed concern about placing lithium battery storage and diesel generators immediately adjacent to homes, and added it is concerning because it appears the project will not pay the same sales tax rate as neighboring businesses. She asked the applicant to explain why these uses should be permitted next to residential areas.\\par\r\n\\par\r\nMr. Morris acknowledged the Mayor\\rquote s concerns regarding lithium battery and diesel generator use near residential areas and stated those concerns were warranted. He explained that the proposed data center, unlike others, would be an adaptive reuse of an existing facility. He explained the building has historically operated for manufacturing which means it had chemical handling and storage of flammable materials. He emphasized the waiver does not introduce new industrial uses but continues those already permitted under the site\\rquote s zoning. He noted that the property sits in a transitional area with residential uses on two sides and heavy industrial uses on the others.\\par\r\n\\par\r\nMayor Gallego stated they are emphasizing for data centers to give back to their surrounding communities and asked Mr. Morris to speak on what the applicant would be bringing to theirs.\\par\r\n\\par\r\nMr. Morris responded the applicant was limited by the size of the site, which already included an existing building and parking area. He highlighted that during a community meeting, residents requested enhanced landscaping, mature trees, a mural, and consideration of a gated landscape setting with security features such as cameras and on-site personnel. He noted these items were the primary community requests. He emphasized the applicant agreed to establish a community fund to be managed in coordination with the City and neighborhood for things that were important to residents.\\par\r\n\\par\r\nMayor Gallego asked how many residents attended the community meeting.\\par\r\n\\par\r\nMr. Morris responded there was roughly 410 homes invited, 148 homes were interacted with, and less than 20 attended the community meeting.\\par\r\n\\par\r\nMayor Gallego stated she heard there had been only four.\\par\r\n\\par\r\nMr. Morris stated he was not present at the meeting.\\par\r\n\\par\r\nCouncilwoman Pastor stated there had been six.\\par\r\n\\par\r\nMayor Gallego stated the site was not her preferred location for a data center because residential properties border two sides of the site. She noted a press release expressing that regional economic development partners and a council member were excited about the project complicated the situation, especially given the timing. She urged the industry to prioritize industrial-zoned locations rather than sites adjacent to residential sites.\\par\r\n\\par\r\nCouncilwoman Pastor stated she shared the Mayor\\rquote s concerns. She noted that the area is zoned for industrial use and sits within a larger industrial park. She referenced the article quoted by the Mayor and observed that earlier efforts sought data center investment as an economic benefit, but community impacts have recently become more apparent over time. She stated that the project was initiated in 2024 and a letter at that time established the site as eligible for data center use. She added the City adopted its regulatory framework in 2025, and this project is one of the few remaining sites that is part of a limbo period under those rules.\\par\r\n\\par\r\n\\b Motion was made by Councilwoman Pastor motioned to approve this item as revised. The motion was seconded by Councilwoman O'Brien.\\b0\\par\r\n\\par\r\nPrior to her vote, Vice Mayor Hodge Washington expressed her shared concern for the placement of data centers in the proximity of residential areas.\\b\\par\r\n}\r\n","EventItemActionId":363,"EventItemActionName":"adopted","EventItemActionText":"A motion was made by Councilwoman Pastor, seconded by Councilwoman O'Brien, that this item be adopted as revised per the memo from the Law Department dated July 1, 2026. The motion carried by the following vote:","EventItemPassedFlag":1,"EventItemPassedFlagName":"Pass","EventItemRollCallFlag":0,"EventItemFlagExtra":null,"EventItemTitle":"Authorization to Grant 5C Data Centers (5C) a Binding Waiver of Enforcement (Waiver) of the Special Permit Provisions for Data Centers (Ordinance S-53089) - District 4","EventItemTally":null,"EventItemAccelaRecordId":null,"EventItemConsent":0,"EventItemMoverId":195,"EventItemMover":"Laura Pastor","EventItemSeconderId":1772,"EventItemSeconder":"Ann O'Brien","EventItemMatterId":35495,"EventItemMatterGuid":"C8664734-0E35-4087-834A-4CCC38055533","EventItemMatterFile":"26-1460","EventItemMatterName":null,"EventItemMatterType":"Ordinance-S","EventItemMatterStatus":"Adopted","EventItemMatterAttachments":[{"MatterAttachmentId":73940,"MatterAttachmentGuid":"0B59DFEA-317F-4487-A35E-E1C215928833","MatterAttachmentLastModifiedUtc":"2026-06-29T20:23:40.313","MatterAttachmentRowVersion":"AAAAAASSe04=","MatterAttachmentName":"Additional Information Memo for 7-1-26 Formal.pdf","MatterAttachmentHyperlink":"https://phoenix.legistar1.com/phoenix/attachments/e30a5e97-1192-45ab-a9c1-c4c54a15984c.pdf","MatterAttachmentFileName":"e30a5e97-1192-45ab-a9c1-c4c54a15984c.pdf","MatterAttachmentMatterVersion":"0","MatterAttachmentIsHyperlink":false,"MatterAttachmentBinary":null,"MatterAttachmentIsSupportingDocument":false,"MatterAttachmentShowOn