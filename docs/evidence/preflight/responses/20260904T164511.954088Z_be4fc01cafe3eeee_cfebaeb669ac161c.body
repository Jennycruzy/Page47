c":"2026-05-28T22:01:04.963","MatterAttachmentRowVersion":"AAAAAASMoeA=","MatterAttachmentName":"Attachment B - Jojo Mini Mart - Map.pdf","MatterAttachmentHyperlink":"https://phoenix.legistar1.com/phoenix/attachments/dd26426a-cc2a-4e1b-a35c-b2cd9967793a.pdf","MatterAttachmentFileName":"dd26426a-cc2a-4e1b-a35c-b2cd9967793a.pdf","MatterAttachmentMatterVersion":"0","MatterAttachmentIsHyperlink":false,"MatterAttachmentBinary":null,"MatterAttachmentIsSupportingDocument":false,"MatterAttachmentShowOnInternetPage":true,"MatterAttachmentIsMinuteOrder":false,"MatterAttachmentIsBoardLetter":false,"MatterAttachmentAgiloftId":0,"MatterAttachmentDescription":null,"MatterAttachmentPrintWithReports":false,"MatterAttachmentSort":-2147483648}]},{"EventItemId":64807,"EventItemGuid":"D18166DB-EE5B-4B95-B173-A05E35CB5A8D","EventItemLastModifiedUtc":"2026-07-15T19:30:46.96","EventItemRowVersion":"AAAAAASVFl8=","EventItemEventId":2651,"EventItemAgendaSequence":38,"EventItemMinutesSequence":42,"EventItemAgendaNumber":"32","EventItemVideo":null,"EventItemVideoIndex":null,"EventItemVersion":"1","EventItemAgendaNote":null,"EventItemMinutesNote":null,"EventItemActionId":365,"EventItemActionName":"recommended for approval","EventItemActionText":"This item was recommended for approval.","EventItemPassedFlag":1,"EventItemPassedFlagName":"Pass","EventItemRollCallFlag":0,"EventItemFlagExtra":0,"EventItemTitle":"Liquor License - Special Event - Arizona Black Bar - District 8","EventItemTally":null,"EventItemAccelaRecordId":null,"EventItemConsent":1,"EventItemMoverId":null,"EventItemMover":null,"EventItemSeconderId":null,"EventItemSeconder":null,"EventItemMatterId":35373,"EventItemMatterGuid":"797D3118-781B-4F64-AD5A-A0876AC47A2E","EventItemMatterFile":"26-1338","EventItemMatterName":null,"EventItemMatterType":"License - Special Event","EventItemMatterStatus":"Recommended for Approval","EventItemMatterAttachments":[]},{"EventItemId":64852,"EventItemGuid":"2D0B96F3-3DDA-4408-98E3-512C59FAACF1","EventItemLastModifiedUtc":"2026-08-04T16:50:14.487","EventItemRowVersion":"AAAAAASVFl8=","EventItemEventId":2651,"EventItemAgendaSequence":86,"EventItemMinutesSequence":101,"EventItemAgendaNumber":"75","EventItemVideo":null,"EventItemVideoIndex":null,"EventItemVersion":"1","EventItemAgendaNote":null,"EventItemMinutesNote":"{\\rtf1\\ansi\\ansicpg1252\\deff0\\deflang1033{\\fonttbl{\\f0\\fnil\\fcharset0 Arial;}}\r\n{\\colortbl ;\\red0\\green0\\blue0;}\r\n\\viewkind4\\uc1\\pard\\cf1\\b\\fs28 Discussion\\par\r\nMotion was made by Vice Mayor Hodge Washington to approve this item. The motion was seconded by Councilwoman O'Brien.\\par\r\n\\b0\\par\r\nMayor Gallego explained the Secure Water Arizona Program (SWAP) partnership would help Phoenix and other Arizona communities adapt to significant reductions in Colorado River supplies by creating a voluntary framework for water sharing, and conservation projects. She stated the City of Phoenix took seriously their leadership role in the state and expressed pride for the City's role in establishing a mutual aid framework known as the SWAP. She noted the program provided flexibility for communities facing shortages, supported innovative conservation efforts throughout the State of Arizona, and established a mutual support framework to face uncertainties with the Colorado River basin.\\par\r\n\\par\r\nVice Mayor Hodge Washington stated the agreement was an important solution in their collaborative effort to strengthen Phoenix\\rquote s long-term water security and prepared the City for potential reductions from the Central Arizona Project (CAP). She stated the agreements would establish an emergency water reserve, support reduction-offset tools, and enable new water transactions. She thanked the Water Services and Water Resources teams for their leadership and encouraged other CAP communities to participate. She emphasized the agreement was a testament to continued efforts for collaboration and was a step forward for the entire region.\\par\r\n}\r\n","EventItemActionId":363,"EventItemActionName":"adopted","EventItemActionText":"A motion was made by Vice Mayor Hodge Washington, seconded by Councilwoman O'Brien, that this item be adopted. The motion carried by the following vote:","EventItemPassedFlag":1,"EventItemPassedFlagName":"Pass","EventItemRollCallFlag":0,"EventItemFlagExtra":0,"EventItemTitle":"Water Services Department Mutual Aid Agreement (Ordinance S-53077) - Citywide","EventItemTally":null,"EventItemAccelaRecordId":null,"EventItemConsent":0,"EventItemMoverId":2022,"EventItemMover":"Kesha Hodge Washington","EventItemSeconderId":1772,"EventItemSeconder":"Ann O'Brien","EventItemMatterId":35376,"EventItemMatterGuid":"9DF9F23B-2334-40DC-9A35-FC7A4C707DCD","EventItemMatterFile":"26-1341","EventItemMatterName":null,"EventItemMatterType":"Ordinance-S","EventItemMatterStatus":"Adopted","EventItemMatterAttachments":[]},{"EventItemId":64828,"EventItemGuid":"7EFED406-9561-43BF-838F-531E459CE5E6","EventItemLastModifiedUtc":"2026-07-15T19:30:46.977","EventItemRowVersion":"AAAAAASVFl8=","EventItemEventId":2651,"EventItemAgendaSequence":61,"EventItemMinutesSequence":65,"EventItemAgendaNumber":"53","EventItemVideo":null,"EventItemVideoIndex":null,"EventItemVersion":"1","EventItemAgendaNote":null,"EventItemMinutesNote":null,"EventItemActionId":363,"EventItemActionName":"adopted","EventItemActionText":"This item was adopted.","EventItemPassedFlag":1,"EventItemPassedFlagName":"Pass","EventItemRollCallFlag":0,"EventItemFlagExtra":0,"EventItemTitle":"Lease of High-Volume Digital Color Production Press Contract - RFP 26-0158 - Request for Award (Ordinance S-53078) - Citywide","EventItemTally":null,"EventItemAccelaRecordId":null,"EventItemConsent":1,"EventItemMoverId":null,"EventItemMover":null,"EventItemSeconderId":null,"EventItemSeconder":null,"EventItemMatterId":35385,"EventItemMatterGuid":"3BFB6D92-D3F3-4E82-B25A-106DCBBD1C35","EventItemMatterFile":"26-1350","EventItemMatterName":null,"EventItemMatterType":"Ordinance-S","EventItemMatterStatus":"Adopted","EventItemMatterAttachments":[]},{"EventItemId":64871,"EventItemGuid":"DE399B4F-FF1B-4629-8E30-F893ACA2934D","EventItemLastModifiedUtc":"2026-08-04T16:55:03.837","EventItemRowVersion":"AAAAAASVFl8=","EventItemEventId":2651,"EventItemAgendaSequence":89,"EventItemMinutesSequence":102,"EventItemAgendaNumber":"77","EventItemVideo":null,"EventItemVideoIndex":null,"EventItemVersion":"1","EventItemAgendaNote":null,"EventItemMinutesNote":"{\\rtf1\\ansi\\ansicpg1252\\deff0\\deflang1033{\\fonttbl{\\f0\\fnil\\fcharset0 Arial;}}\r\n{\\colortbl ;\\red0\\green0\\blue0;}\r\n\\viewkind4\\uc1\\pard\\cf1\\b\\fs28 Discussion\\par\r\n\\b0 Mayor Gallego noted there were community members present to speak on the item.\\par\r\n\\par\r\nAlex Johnson expressed his opposition to this item.\\par\r\n\\par\r\nTaylor Twitchell expressed her opposition to this item.\\par\r\n\\par\r\nCouncilman Robinson asked Planning and Development Director Joshua Bednarek to clarify Mr. Johnson's concern about whether the property was properly zoned.\\par\r\n\\par\r\nMr. Bednarek explained that the property is zoned General Commerce Park and has held that zoning designation for several years. He stated the concern appeared to relate to the data center regulatory framework adopted by the City Council approximately one year ago. He stated the ordinance included a specific provision which stated any property that obtained preliminary site plan approval before the ordinance was adopted would not be subject to the new standards. This property met that condition as it had secured preliminary site plan approval prior to the Council\\rquote s adoption of the data center ordinance last year. He explained that therefore, data center use was allowed on the site and the project was not required to comply with the newer standards.\\par\r\n\\par\r\nCouncilman Robinson invited the applicant\\rquote s zoning attorney, Nick Wood, to address some questions. Councilman Robinson asked him to address the zoning clarification provided by Mr. Bednarek and to explain the mitigation measures, including noise-related concerns, that the project will be required to follow through the planning process.\\par\r\n\\par\r\nMr. Wood stated the zoning was approved decades ago and amended in 2024 to allow data centers and office use. He explained that required mitigation included substantial setbacks, the site being significantly below grade, and extensive landscaping around the property. He noted the buildings would be set back approximately 200 to 300 feet.\\par\r\n\\par\r\nCouncilman Robinson asked him about the efforts conducted to contact the surrounding community members.\\par\r\n\\par\r\nMr. Wood responded they had an outreach team that knocked on 1,000 doors, of those they were able to connect with over 400 residents, and received several hundred letters of support.\\par\r\n\\par\r\nMayor Gallego asked what the applicant's commitment was to the community.\\par\r\n\\par\r\nMr. Wood stated the applicant has committed to building and maintaining a publicly accessible park with amenities, designed in collaboration with residents, at no cost to the City.\\par\r\n\\par\r\nCouncilman Robinson acknowledged the concerns expressed by residents and stated he had met with several segments of community groups and will continue to do so. He emphasized the action before the Council was administrative and did not expand, accelerate, or alter the already approved data center project. He explained when Council adopted the data center ordinance last year, it intentionally set a boundary exempting developments with prior preliminary site approval to ensure the ordinance was legally sound and enforceable. He noted this project was one of two sites meeting that criterion. He stated that approving the item did not diminish the importance of continued community engagement.\\par\r\n\\b\\par\r\nMotion was made by Councilman Robinson to approve this item and adopt the related resolution. The motion was seconded by Vice Mayor Hodge Washington.\\par\r\n\\b0\\par\r\nMayor Gallego addressed the residents present and acknowledged their frustration regarding data center development. She referenced a recent Wall Street Journal article describing Phoenix as a hub for data centers, noting the City has been working to reform and strengthen its regulatory framework. She stated when the Council adopted the updated data center permit process, it was considered amongst the strongest in the nation and was passed unanimously despite heavy industry criticism. She explained the Phoenix region now has one of the highest concentrations of data centers globally, driven in part by state-level tax incentives. She noted she advocated for data centers to pay the same tax rate as small businesses and that the State budget recently established a three-year moratorium on the most generous tax incentives, though some projects would still qualify.\\par\r\n\\par\r\nMayor Gallego stated the City continues to push for responsible management of data center impacts but must navigate more than millions in threatened litigation. She emphasized the importance of protecting City tax dollars and managing water resources carefully, including ensuring that groundwater and other supplies are used for the highest and best purposes. She reiterated the City must operate within the parameters set by the State of Arizona while continuing to pursue reforms that protect community health and safety. She thanked residents for attending and acknowledged that she shares their frustration. \\par\r\n\\par\r\nVice Mayor Hodge Washington echoed the Mayor\\rquote s and Councilman Robinson\\rquote s comments, acknowledging residents\\rquote  frustration and emphasizing confidence in Councilman Robinson\\rquote s commitment to continued community engagement. Vice Mayor Hodge Washington requested the Planning and Development Department respond to the submitted questions to help address community concerns. She noted that data centers are a national issue and uncertainty remains about their impact. She stated while the City is bound by legal frameworks and its own ordinance, developers should continue engaging with residents to ensure the process works for both the community and the project.\\par\r\n}\r\n","EventItemActionId":363,"EventItemActionName":"adopted","EventItemActionText":"A motion was made by Councilman Robinson, seconded by Vice Mayor Hodge Washington, that the abandonment be approved with adoption of the related resolution. The motion carried by the following vote:","EventItemPassedFlag":1,"EventItemPassedFlagName":"Pass","EventItemRollCallFlag":0,"EventItemFlagExtra":null,"EventItemTitle":"Abandonment of Easement - ABND 250032 - 4805, 4809, 4801, and 4811 E. Thistle Landing Drive (Resolution 22388) - District 6","EventItemTally":null,"EventItemAccelaRecordId":null,"EventItemConsent":0,"EventItemMoverId":2023,"EventItemMover":"Kevin Robinson","EventItemSeconderId":2022,"EventItemSeconder":"Kesha Hodge Washington","EventItemMatterId":35388,"EventItemMatterGuid":"0D801ED2-1D35-4934-B4DE-AD4C48B8BA78","EventItemMatterFile":"26-1353","EventItemMatterName":null,"EventItemMatterType":"Resolution","EventItemMatterStatus":"Adopted","EventItemMatterAttachments":[{"MatterAttachmentId":73565,"MatterAttachmentGuid":"63A9626E-1739-4C91-8A93-539F711A6E52","MatterAttachmentLastModifiedUtc":"2026-06-01T18:53:58.607","MatterAttachmentRowVersion":"AAAAAASLjLE=","MatterAttachmentName":"Attachment A - Aerial Map ABND 250032.pdf","MatterAttachmentHyperlink":"https://phoenix.legistar1.com/phoenix/attachments/744174a4-2822-43af-8401-c82fd9f89183.pdf","MatterAttachmentFileName":"744174a4-2822-43af-8401-c82fd9f89183.pdf","MatterAttachmentMatterVersion":"0","MatterAttachmentIsHyperlink":false,"MatterAttachmentBinary":null,"MatterAttachmentIsSupportingDocument":false,"MatterAttachmentShowOnInternetPage":true,"MatterAttachmentIsMinuteOrder":false,"MatterAttachmentIsBoardLette