{"EventId":6865,"EventGuid":"6615A779-D5D1-4434-9BEE-CFD268AC3EC8","EventLastModifiedUtc":"2026-08-17T20:36:24.647","EventRowVersion":"AAAAAAFKaYM=","EventBodyId":138,"EventBodyName":"City Council","EventDate":"2026-08-18T00:00:00","EventTime":"2:00 PM","EventVideoStatus":"Public","EventAgendaStatusId":10,"EventAgendaStatusName":"Final","EventMinutesStatusId":10,"EventMinutesStatusName":"Final","EventLocation":"Council Chamber, City Hall\r\n600 4th Avenue\r\nSeattle, WA 98104","EventAgendaFile":"https://legistar2.granicus.com/seattle/meetings/2026/8/6865_A_City_Council_26-08-18_Full_Council_Meeting_Agenda.pdf","EventMinutesFile":null,"EventAgendaLastPublishedUTC":"2026-08-17T20:36:24.617","EventMinutesLastPublishedUTC":null,"EventComment":null,"EventVideoPath":null,"EventMedia":"https://seattlechannel.org/FullCouncil?videoid=x189377","EventInSiteURL":"https://seattle.legistar.com/MeetingDetail.aspx?LEGID=6865&GID=393&G=FFE3B678-CEF6-4197-84AC-5204EA4CFC0C","EventItems":[{"EventItemId":125357,"EventItemGuid":"E8606406-B60A-47D2-9D07-39152528E0BB","EventItemLastModifiedUtc":"2026-08-18T21:50:10.417","EventItemRowVersion":"AAAAAAFKaYM=","EventItemEventId":6865,"EventItemAgendaSequence":1,"EventItemMinutesSequence":1,"EventItemAgendaNumber":null,"EventItemVideo":null,"EventItemVideoIndex":null,"EventItemVersion":null,"EventItemAgendaNote":"{\\rtf1\\ansi\\ansicpg1252\\deff0{\\fonttbl{\\f0\\fnil\\fcharset0 Arial;}}\r\n{\\colortbl ;\\red0\\green0\\blue255;}\r\n\\viewkind4\\uc1\\pard\\lang1033\\fs24 Members of the public may register for remote or in-person Public Comment to address the Council. Speakers must be registered in order to be recognized by the Chair. Details on how to register for Public Comment are listed below:\\par\r\n\\par\r\nRemote Public Comment - Register online to speak during the Public Comment period at \\cf1\\ul https://www.seattle.gov/council/committees/public-comment\\cf0\\ulnone . Online registration to speak will begin one hour before the meeting start time, and registration will end at the conclusion of the Public Comment period during the meeting. \\par\r\n\\par\r\nIn-Person Public Comment - Register to speak on the public comment sign-up sheet located inside Council Chambers at least 15 minutes prior to the meeting start time. Registration will end at the conclusion of the Public Comment period during the meeting. \\par\r\n\\par\r\nWritten comments must be submitted prior to 10 a.m. to ensure that they are distributed to Councilmembers prior to the start of the meeting. Comments may be submitted at \\cf1\\ul Council@seattle.gov\\cf0\\ulnone  or at Seattle City Hall, Attn: Council Public Comment, 600 4th Ave., Floor 2, Seattle, WA 98104. Comments received after 10 a.m. will be distributed after the meeting to Councilmembers and included as part of the public record.\\par\r\n}\r\n","EventItemMinutesNote":null,"EventItemActionId":null,"EventItemActionName":null,"EventItemActionText":null,"EventItemPassedFlag":null,"EventItemPassedFlagName":null,"EventItemRollCallFlag":0,"EventItemFlagExtra":0,"EventItemTitle":"   \r\n\r\n","EventItemTally":null,"EventItemAccelaRecordId":null,"EventItemConsent":0,"EventItemMoverId":null,"EventItemMover":null,"EventItemSeconderId":null,"EventItemSeconder":null,"EventItemMatterId":null,"EventItemMatterGuid":null,"EventItemMatterFile":null,"EventItemMatterName":null,"EventItemMatterType":null,"EventItemMatterStatus":null,"EventItemMatterAttachments":[]},{"EventItemId":125358,"EventItemGuid":"A2BDA727-FC14-4DAB-A517-EC8810A40E67","EventItemLastModifiedUtc":"2026-08-19T13:16:18.77","EventItemRowVersion":"AAAAAAFKaYM=","EventItemEventId":6865,"EventItemAgendaSequence":2,"EventItemMinutesSequence":2,"EventItemAgendaNumber":"A.","EventItemVideo":null,"EventItemVideoIndex":null,"EventItemVersion":null,"EventItemAgendaNote":null,"EventItemMinutesNote":"{\\rtf1\\ansi\\ansicpg1252\\deff0\\deflang1033{\\fonttbl{\\f0\\fnil\\fcharset0 Arial;}}\r\n{\\colortbl ;\\red0\\green0\\blue0;}\r\n\\viewkind4\\uc1\\pard\\fs24 The City Council of The City of Seattle met in the Council Chamber in City Hall in Seattle, Washington, on August 18, 2026, pursuant to the provisions of the City Charter. The meeting was called to order at 2:06 p.m., with Council President Hollingsworth presiding.\\fs17\\par\r\n\\cf1\\fs24\\par\r\n}\r\n","EventItemActionId":null,"EventItemActionName":null,"EventItemActionText":null,"EventItemPassedFlag":null,"EventItemPassedFlagName":null,"EventItemRollCallFlag":0,"EventItemFlagExtra":0,"EventItemTitle":"CALL TO ORDER","EventItemTally":null,"EventItemAccelaRecordId":null,"EventItemConsent":0,"EventItemMoverId":null,"EventItemMover":null,"EventItemSeconderId":null,"EventItemSeconder":null,"EventItemMatterId":null,"EventItemMatterGuid":null,"EventItemMatterFile":null,"EventItemMatterName":null,"EventItemMatterType":null,"EventItemMatterStatus":null,"EventItemMatterAttachments":[]},{"EventItemId":125359,"EventItemGuid":"531DD7AD-A8F6-44D2-869A-AD1EF3022FFB","EventItemLastModifiedUtc":"2026-08-18T21:51:20.3","EventItemRowVersion":"AAAAAAFKaYM=","EventItemEventId":6865,"EventItemAgendaSequence":3,"EventItemMinutesSequence":3,"EventItemAgendaNumber":"B.","EventItemVideo":null,"EventItemVideoIndex":null,"EventItemVersion":null,"EventItemAgendaNote":null,"EventItemMinutesNote":null,"EventItemActionId":null,"EventItemActionName":null,"EventItemActionText":null,"EventItemPassedFlag":null,"EventItemPassedFlagName":null,"EventItemRollCallFlag":1,"EventItemFlagExtra":0,"EventItemTitle":"ROLL CALL","EventItemTally":null,"EventItemAccelaRecordId":null,"EventItemConsent":0,"EventItemMoverId":null,"EventItemMover":null,"EventItemSeconderId":null,"EventItemSeconder":null,"EventItemMatterId":null,"EventItemMatterGuid":null,"EventItemMatterFile":null,"EventItemMatterName":null,"EventItemMatterType":null,"EventItemMatterStatus":null,"EventItemMatterAttachments":[]},{"EventItemId":125360,"EventItemGuid":"28917653-9CF7-4B05-A0ED-7BBF22121508","EventItemLastModifiedUtc":"2026-08-19T18:38:03.33","EventItemRowVersion":"AAAAAAFKaYM=","EventItemEventId":6865,"EventItemAgendaSequence":4,"EventItemMinutesSequence":4,"EventItemAgendaNumber":"C.","EventItemVideo":null,"EventItemVideoIndex":null,"EventItemVersion":null,"EventItemAgendaNote":null,"EventItemMinutesNote":"{\\rtf1\\ansi\\ansicpg1252\\deff0\\deflang1033{\\fonttbl{\\f0\\fswiss\\fprq2\\fcharset0 Arial;}{\\f1\\fnil\\fcharset0 Arial;}}\r\n{\\colortbl ;\\red0\\green0\\blue0;}\r\n\\viewkind4\\uc1\\pard\\kerning2\\f0\\fs24 Councilmember Rivera presented a proclamation for signature recognizing August 18, 2026 as \\ldblquote Allynn Ruth Day.\\rdblquote  \\par\r\n\\par\r\nThe following Councilmembers affixed their signatures to the proclamation: 5 - Hollingsworth, Kettle, Lin, Rinck, Rivera\\par\r\n\\par\r\nBy unanimous consent, the Council Rules were suspended to allow Councilmember Rivera to present the proclamation, and to allow Director Quynh Pham, Zachary Pulllin, and Iona McKenzie, from the Department of Neighborhoods, and Clifford Holland and Miss Allynn Ruth, to address the Council.\\cf1\\kerning0\\f1\\par\r\n}\r\n","EventItemActionId":null,"EventItemActionName":null,"EventItemActionText":null,"EventItemPassedFlag":null,"EventItemPassedFlagName":null,"EventItemRollCallFlag":0,"EventItemFlagExtra":0,"EventItemTitle":"PRESENTATIONS","EventItemTally":null,"EventItemAccelaRecordId":null,"EventItemConsent":0,"EventItemMoverId":null,"EventItemMover":null,"EventItemSeconderId":null,"EventItemSeconder":null,"EventItemMatterId":null,"EventItemMatterGuid":null,"EventItemMatterFile":null,"EventItemMatterName":null,"EventItemMatterType":null,"EventItemMatterStatus":null,"EventItemMatterAttachments":[]},{"EventItemId":125361,"EventItemGuid":"55BF502A-C482-4636-AE0D-38A48FCC4A63","EventItemLastModifiedUtc":"2026-08-19T18:37:38.47","EventItemRowVersion":"AAAAAAFKaYM=","EventItemEventId":6865,"EventItemAgendaSequence":5,"EventItemMinutesSequence":5,"EventItemAgendaNumber":"D.","EventItemVideo":null,"EventItemVideoIndex":null,"EventItemVersion":null,"EventItemAgendaNote":"Members of the public may sign up to address the Council for up to 2 minutes on matters on this agenda; Introduction and Referral Calendar; and Council's Work Program; and total time allotted to public comment at this meeting is up to one hour.","EventItemMinutesNote":"{\\rtf1\\ansi\\ansicpg1252\\deff0\\deflang1033{\\fonttbl{\\f0\\fnil\\fcharset0 Arial;}}\r\n{\\colortbl ;\\red0\\green0\\blue0;}\r\n\\viewkind4\\uc1\\pard\\cf1\\fs24 The following individuals addressed the Council:\\par\r\nJacqueline A. Ware\\par\r\nShelley Morrison\\par\r\nPaul Wang Gosselin\\par\r\nPatrick McKee\\par\r\nCatherine Alexander\\par\r\nPatricia Killam\\par\r\nYvette Dinish\\par\r\nDavid Haines\\par\r\nLaurel Harkly\\par\r\nRose Legionaires\\par\r\nCedar Bushue\\par\r\nAndrelyn Izquierdo\\par\r\n}\r\n","EventItemActionId":null,"EventItemActionName":null,"EventItemActionText":null,"EventItemPassedFlag":null,"EventItemPassedFlagName":null,"EventItemRollCallFlag":0,"EventItemFlagExtra":0,"EventItemTitle":"PUBLIC COMMENT ","EventItemTally":null,"EventItemAccelaRecordId":null,"EventItemConsent":0,"EventItemMoverId":null,"EventItemMover":null,"EventItemSeconderId":null,"EventItemSeconder":null,"EventItemMatterId":null,"EventItemMatterGuid":null,"EventItemMatterFile":null,"EventItemMatterName":null,"EventItemMatterType":null,"EventItemMatterStatus":null,"EventItemMatterAttachments":[]},{"EventItemId":125362,"EventItemGuid":"F5DBEC55-8C5B-4724-8925-4ACE0ED32BBC","EventItemLastModifiedUtc":"2026-08-17T19:54:55.843","EventItemRowVersion":"AAAAAAFKaYM=","EventItemEventId":6865,"EventItemAgendaSequence":6,"EventItemMinutesSequence":6,"EventItemAgendaNumber":"E.","EventItemVideo":null,"EventItemVideoIndex":null,"EventItemVersion":null,"EventItemAgendaNote":"Introduction and referral to Council committees of Council Bills (CB), Resolutions (Res), Appointments (Appt), and Clerk Files (CF) for committee recommendation.","